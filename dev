  for f in "${files[@]}"; do
    [[ -f "$ORCH_DIR/$f" ]] || missing+=("$f")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "ERROR: Missing orchestrator prompt files in ${ORCH_DIR}: ${missing[*]}"
