  local panes
  panes=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_index} #{pane_left}" 2>/dev/null) || return 1
  [[ -z "$panes" ]] && return 1
  if [[ "$side" == "right" ]]; then
    echo "$panes" | sort -k2,2n | tail -1 | awk '{print $1}'
  else
    echo "$panes" | sort -k2,2n | head -1 | awk '{print $1}'
  fi
}

_pane_target_for_side() {
