#!/usr/bin/env zsh
# Dev - Project launcher & Claude Code orchestrator
# Usage: dev <project> | dev list | dev start <project> | dev send <project> "msg"
# Requires: zsh, tmux, Claude Code (https://docs.anthropic.com/en/docs/claude-code)

# Clear nested Claude Code detection
unset CLAUDECODE

# Dependency check
if ! command -v tmux &>/dev/null; then
  echo "ERROR: tmux is required but not found. Install it first."
  exit 1
fi

# Config
CONFIG_DIR="${ORCHESTRA_CONFIG_DIR:-$HOME/.config/orchestra}"
PROJECTS_FILE="$CONFIG_DIR/projects.conf"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"

# Validate CLAUDE_BIN before any tmux send-keys usage (prevents injection)
_require_claude() {
  if [[ ! -x "$CLAUDE_BIN" ]]; then
    echo "ERROR: Claude binary not found or not executable: $CLAUDE_BIN"
    echo "Install Claude Code: https://docs.anthropic.com/en/docs/claude-code"
    return 1
  fi
}
ORCH_SESSION="${ORCHESTRA_SESSION:-devenv}"
# ORCH_DIR: where CLAUDE.md lives for orchestrator mode
# Override with ORCHESTRA_DIR env var or set in ~/.config/orchestra/orchestra.conf
ORCH_DIR="${ORCHESTRA_DIR:-$HOME/.config/orchestra}"
MAX_CLAUDE_SESSIONS="${MAX_CLAUDE_SESSIONS:-5}"
# Claude Code sets its process title to its version (e.g., "2.1.72"), not "node"
CLAUDE_PROC_PATTERN="^[0-9]+\.[0-9]+\.[0-9]+$"
LOG_DIR="${HOME}/.local/share/orchestra/logs"
HISTORY_FILE="${HOME}/.local/share/orchestra/history.log"
STATES_DIR="${HOME}/.config/orchestra/states"

# Log an action to history file
_log_history() {
  mkdir -p "$(dirname "$HISTORY_FILE")"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$HISTORY_FILE"
}

# Desktop notification helper (macOS + Linux)
_notify() {
  local title="${1:-Orchestra}"
  local msg="${2:-Task complete}"
  if command -v osascript &>/dev/null; then
    osascript - "$title" "$msg" <<'APPLESCRIPT' 2>/dev/null
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
  elif command -v notify-send &>/dev/null; then
    notify-send "$title" "$msg" 2>/dev/null
  fi
}

# Load projects from config file
typeset -A PROJECTS
_load_projects() {
  if [[ ! -f "$PROJECTS_FILE" ]]; then
    echo "No projects configured. Run: dev add <alias> /path/to/project"
    echo "Config: $PROJECTS_FILE"
    return 1
  fi
  while IFS='=' read -r key val; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    key="${key## }"; key="${key%% }"
    val="${val## }"; val="${val%% }"
    # Expand ~ and $HOME
    val="${val/#\~/$HOME}"
    val="${val/\$HOME/$HOME}"
    PROJECTS[$key]="$val"
  done < "$PROJECTS_FILE"
}

_load_projects

# Add a project to config
_add() {
  local alias="$1"
  local dir="$2"

  if [[ -z "$alias" || -z "$dir" ]]; then
    echo "Usage: dev add <alias> /path/to/project"
    return 1
  fi

  # Validate alias: only alphanumeric, hyphens, underscores
  if [[ ! "$alias" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Invalid alias: use only letters, numbers, hyphens, underscores"
    return 1
  fi

  # Resolve to absolute path
  dir="${dir/#\~/$HOME}"
  [[ ! "$dir" = /* ]] && dir="$(cd "$dir" 2>/dev/null && pwd)"

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  if [[ -n "${PROJECTS[$alias]}" ]]; then
    echo "Alias '$alias' already exists: ${PROJECTS[$alias]}"
    echo "Remove first with: dev remove $alias"
    return 1
  fi

  mkdir -p "$CONFIG_DIR"
  echo "$alias=$dir" >> "$PROJECTS_FILE"
  PROJECTS[$alias]="$dir"
  echo "Added: $alias -> $dir"
}

# Remove a project from config
_remove() {
  local alias="$1"
  if [[ -z "$alias" ]]; then
    echo "Usage: dev remove <alias>"
    return 1
  fi

  if [[ -z "${PROJECTS[$alias]}" ]]; then
    echo "Unknown project: $alias"
    return 1
  fi

  # Remove line from config (atomic: write to tmp, verify, then replace)
  local tmpfile=$(mktemp "$CONFIG_DIR/projects.XXXXXX")
  grep -vE "^${alias}=" "$PROJECTS_FILE" > "$tmpfile" || true
  mv "$tmpfile" "$PROJECTS_FILE"
  unset "PROJECTS[$alias]"
  echo "Removed: $alias"
}

# Helper: count active Claude windows in the orchestra session
_claude_count() {
  local count=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && count=$((count + 1))
    done <<< "$windows"
  fi
  echo "$count"
}

# Resource monitoring: get system load and memory pressure
_system_load() {
  local cores=$(sysctl -n hw.ncpu 2>/dev/null || echo 4)
  local load=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}' || echo 0)
  local mem_pressure=$(memory_pressure 2>/dev/null | grep "System-wide memory free percentage" | awk '{print $NF}' | tr -d '%' || echo 50)
  echo "$load $cores $mem_pressure"
}

# Auto-cleanup: detect idle workers when system is under pressure
# NEVER kills workers automatically — only reports to orchestrator Claude
# The orchestrator must ask the user for permission before killing
_auto_cleanup() {
  local force="${1:-}"  # --force flag skips pressure check (for manual cleanup command)
  local load_info=($(_system_load))
  local load=${load_info[1]:-0}
  local cores=${load_info[2]:-4}
  local mem_free=${load_info[3]:-50}

  # Calculate load threshold (1.5x cores)
  local threshold=$(echo "$cores * 1.5" | bc 2>/dev/null || echo 12)

  # Check if system is under pressure
  local pressure=0
  if (( $(echo "$load > $threshold" | bc 2>/dev/null || echo 0) )); then
    pressure=1
  fi
  if [[ "$mem_free" -lt 10 ]]; then
    pressure=1
  fi

  if [[ $pressure -eq 0 && "$force" != "--force" ]]; then
    return 0
  fi

  # Find idle workers — report them, do NOT kill
  local idle_workers=()
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      _is_done "$wname" 2>/dev/null
      if [[ $? -eq 0 ]]; then
        idle_workers+=("$wname")
      fi
    done <<< "$windows"
  fi

  # Report to orchestrator — let Claude ask user
  if [[ $pressure -eq 1 ]]; then
    echo "⚠️  SYSTEM UNDER PRESSURE (load: $load/$threshold, mem free: ${mem_free}%)"
  fi

  if [[ ${#idle_workers[@]} -gt 0 ]]; then
    echo "IDLE_WORKERS_FOUND: ${idle_workers[*]}"
    echo "These idle workers can be killed to free resources:"
    for w in "${idle_workers[@]}"; do
      echo "  - $w (idle)"
    done
    echo ""
    echo "To kill specific workers: dev kill <worker_name>"
    echo "To kill all idle: dev cleanup --confirm"
  else
    echo "No idle workers found."
  fi
}

# Confirmed cleanup: actually kill idle workers (only after user approval)
_cleanup_confirmed() {
  local killed=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      _is_done "$wname" 2>/dev/null
      if [[ $? -eq 0 ]]; then
        echo "  🧹 Killing idle worker: $wname"
        tmux kill-window -t "$ORCH_SESSION:$wname" 2>/dev/null
        _log_history "CLEANUP: killed idle worker $wname (user confirmed)"
        killed=$((killed + 1))
      fi
    done <<< "$windows"
  fi

  if [[ $killed -eq 0 ]]; then
    echo "No idle workers to clean."
  else
    echo "✅ Cleaned $killed idle worker(s)."
  fi
}

# ─── Project State (persistent memory per project) ───

_state_file() {
  local name="$1"
  echo "$STATES_DIR/${name}.state"
}

_state_get() {
  local name="$1" key="$2"
  local file="$(_state_file "$name")"
  [[ -f "$file" ]] && grep "^${key}=" "$file" 2>/dev/null | cut -d= -f2-
}

_state_set() {
  local name="$1" key="$2" value="$3"
  local file="$(_state_file "$name")"
  mkdir -p "$STATES_DIR"
  if [[ -f "$file" ]] && grep -q "^${key}=" "$file" 2>/dev/null; then
    sed -i '' "s|^${key}=.*|${key}=${value}|" "$file"
  else
    echo "${key}=${value}" >> "$file"
  fi
}

_state_show() {
  local name="$1"
  local file="$(_state_file "$name")"
  if [[ ! -f "$file" ]]; then
    echo "No state for $name"
    return 1
  fi
  echo "=== $name ==="
  local last=$(_state_get "$name" "last_action")
  local last_at=$(_state_get "$name" "last_at")
  local todo=$(_state_get "$name" "next_todo")
  local blockers=$(_state_get "$name" "blockers")
  [[ -n "$last" ]] && echo "  Last: $last ($last_at)"
  [[ -n "$todo" ]] && echo "  Next: $todo"
  [[ -n "$blockers" ]] && echo "  Blocked: $blockers"
  # Show history
  local i=1
  local entry
  echo "  History:"
  while entry=$(_state_get "$name" "history_$i"); do
    [[ -z "$entry" ]] && break
    echo "    $i. $entry"
    i=$((i + 1))
  done
}

_state_add_history() {
  local name="$1" entry="$2"
  local file="$(_state_file "$name")"
  mkdir -p "$STATES_DIR"
  # Shift existing history down (max 10)
  for i in 9 8 7 6 5 4 3 2 1; do
    local prev=$(_state_get "$name" "history_$i")
    [[ -n "$prev" ]] && _state_set "$name" "history_$((i+1))" "$prev"
  done
  _state_set "$name" "history_1" "$entry"
}

_state() {
  local subcmd="$1" name="$2"
  case "$subcmd" in
    show)
      if [[ "$name" == "--all" || -z "$name" ]]; then
        setopt NULL_GLOB 2>/dev/null
        for f in "$STATES_DIR"/*.state; do
          [[ -f "$f" ]] || continue
          local alias=$(basename "$f" .state)
          _state_show "$alias"
          echo ""
        done
      else
        _state_show "$name"
      fi
      ;;
    set)
      local key="$3" value="${*:4}"
      if [[ -z "$name" || -z "$key" ]]; then
        echo "Usage: dev state set <project> <key> <value>"
        return 1
      fi
      _state_set "$name" "$key" "$value"
      ;;
    log)
      local entry="${*:3}"
      if [[ -z "$name" || -z "$entry" ]]; then
        echo "Usage: dev state log <project> \"action description\""
        return 1
      fi
      _state_set "$name" "last_action" "$entry"
      _state_set "$name" "last_at" "$(date '+%Y-%m-%dT%H:%M:%S')"
      _state_add_history "$name" "$entry"
      ;;
    clear)
      if [[ -z "$name" ]]; then
        echo "Usage: dev state clear <project>"
        return 1
      fi
      rm -f "$(_state_file "$name")"
      echo "State cleared: $name"
      ;;
    *)
      echo "Usage: dev state <show|set|log|clear> [project] [args]"
      echo "  show [project|--all]  Show project state"
      echo "  set <project> <key> <value>  Set a state value"
      echo "  log <project> \"action\"  Log an action (updates last + history)"
      echo "  clear <project>  Clear project state"
      ;;
  esac
}

# ─── Project Analyze (live health check) ───

_analyze() {
  local name="$1"
  _load_projects || return 1

  if [[ "$name" == "--all" ]]; then
    printf "%-14s %-10s %-20s %6s %4s %-8s\n" "PROJECT" "TYPE" "BRANCH" "ISSUES" "PRs" "HEALTH"
    printf "%-14s %-10s %-20s %6s %4s %-8s\n" "───────" "────" "──────" "──────" "───" "──────"
    for alias in "${(@k)PROJECTS}"; do
      _analyze_one "$alias" "table"
    done
    return
  fi

  if [[ -z "$name" ]]; then
    echo "Usage: dev analyze <project|--all>"
    return 1
  fi
  _analyze_one "$name" "full"
}

_analyze_one() {
  local name="$1" mode="$2"
  local dir="${PROJECTS[$name]}"
  [[ -z "$dir" ]] && { echo "Unknown project: $name"; return 1; }
  [[ ! -d "$dir" ]] && { echo "Directory not found: $dir"; return 1; }

  # Detect type
  local ptype="unknown"
  [[ -f "$dir/pubspec.yaml" ]] && ptype="flutter"
  [[ -f "$dir/pyproject.toml" || -f "$dir/setup.py" ]] && ptype="python"
  [[ -f "$dir/package.json" && "$ptype" == "unknown" ]] && ptype="node"
  [[ -f "$dir/Cargo.toml" ]] && ptype="rust"

  # Git info
  local branch="" ahead=0 uncommitted=0 last_commit=""
  if [[ -d "$dir/.git" ]]; then
    branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "detached")
    ahead=$(git -C "$dir" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
    uncommitted=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    last_commit=$(git -C "$dir" log -1 --format='%cr' 2>/dev/null || echo "unknown")
  fi

  # GitHub info (fast, timeout 3s)
  local issues=0 prs=0
  local remote_url=$(git -C "$dir" remote get-url origin 2>/dev/null)
  if [[ -n "$remote_url" ]]; then
    issues=$(timeout 3 gh issue list --repo "$remote_url" --state open --limit 100 --json number 2>/dev/null | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null || echo 0)
    prs=$(timeout 3 gh pr list --repo "$remote_url" --state open --limit 100 --json number 2>/dev/null | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null || echo 0)
  fi
  issues=$(echo "${issues:-0}" | tr -d '[:space:]')
  prs=$(echo "${prs:-0}" | tr -d '[:space:]')
  ahead=$(echo "${ahead:-0}" | tr -d '[:space:]')
  uncommitted=$(echo "${uncommitted:-0}" | tr -d '[:space:]')
  [[ "$issues" =~ ^[0-9]+$ ]] || issues=0
  [[ "$prs" =~ ^[0-9]+$ ]] || prs=0
  [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=0
  [[ "$uncommitted" =~ ^[0-9]+$ ]] || uncommitted=0

  # Health
  local health="GREEN"
  (( issues > 0 || uncommitted > 0 || ahead > 0 )) && health="YELLOW"
  (( issues > 10 || uncommitted > 10 )) && health="RED"

  # State info
  local last_action=$(_state_get "$name" "last_action")
  local next_todo=$(_state_get "$name" "next_todo")

  if [[ "$mode" == "table" ]]; then
    printf "%-14s %-10s %-20s %6s %4s %-8s\n" "$name" "$ptype" "$branch" "$issues" "$prs" "$health"
  else
    echo "=== $name ==="
    echo "  Type: $ptype | Branch: $branch ($ahead ahead, $uncommitted uncommitted)"
    echo "  Last commit: $last_commit"
    echo "  Issues: $issues open | PRs: $prs open"
    echo "  Health: $health"
    [[ -n "$last_action" ]] && echo "  Last action: $last_action"
    [[ -n "$next_todo" ]] && echo "  Next: $next_todo"
  fi
}

# Periodic health check — can be called from orchestrator
_health() {
  local load_info=($(_system_load))
  local load=${load_info[1]:-0}
  local cores=${load_info[2]:-4}
  local mem_free=${load_info[3]:-50}
  local active=$(_claude_count)
  local threshold=$(echo "$cores * 1.5" | bc 2>/dev/null || echo 12)

  echo "System Health:"
  echo "  CPU Load: $load (threshold: $threshold, cores: $cores)"
  echo "  Memory Free: ${mem_free}%"
  echo "  Claude Sessions: $active/$MAX_CLAUDE_SESSIONS"

  if (( $(echo "$load > $threshold" | bc 2>/dev/null || echo 0) )); then
    echo "  ⚠️  CPU overloaded!"
  fi
  if [[ "$mem_free" -lt 10 ]]; then
    echo "  ⚠️  Memory critical!"
  fi
  if [[ "$mem_free" -lt 5 ]]; then
    echo "  🔴 Memory emergency! Run 'dev cleanup' to see idle workers, then 'dev cleanup --confirm' to kill them."
    _auto_cleanup --force
  fi
}

# Helper: check if a worker Claude is idle (done with task)
# Returns 0 if idle, 1 if working, 2 if not Claude
_is_done() {
  local name="$1"
  if ! _has_window "$name"; then return 2; fi

  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
  if [[ ! "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then return 2; fi

  # Capture last 10 lines and check for active work indicators
  local output=$(tmux capture-pane -t "$ORCH_SESSION:$name" -p -S -10 2>/dev/null | \
    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tr -d '\xc2\xa0' | sed 's/[[:cntrl:]]//g')

  # Active patterns: Claude is still working
  if echo "$output" | grep -qiE '(running\)|lculating|rnsfiguring|hinking|Reding.*files|iting.*files)'; then
    return 1
  fi

  # Idle pattern: prompt line visible (❯ character)
  if echo "$output" | grep -q '❯'; then
    return 0
  fi

  # Unknown — assume still working
  return 1
}

_done() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: dev done <project>"
    return 1
  fi
  _is_done "$name"
  local result=$?
  case $result in
    0) echo "$name: idle (done)" ;;
    1) echo "$name: working..." ;;
    2) echo "$name: not running Claude" ;;
  esac
  return $result
}

# Helper: check if a window exists in the orchestra session
_has_window() {
  tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null | grep -qx "$1"
}

# Helper: ensure the orchestra tmux session exists
_ensure_session() {
  if ! tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    if [[ ! -d "$ORCH_DIR" ]]; then
      mkdir -p "$ORCH_DIR" || { echo "ERROR: Cannot create ORCH_DIR: $ORCH_DIR"; return 1; }
    fi
    tmux new-session -d -s "$ORCH_SESSION" -n "orchestra" -c "$ORCH_DIR" || {
      echo "ERROR: Failed to create tmux session '$ORCH_SESSION'"
      return 1
    }
  fi
}

_list() {
  if [[ ${#PROJECTS} -eq 0 ]]; then
    echo "No projects configured."
    echo "Add one with: dev add <alias> /path/to/project"
    return
  fi
  echo "Available projects:"
  echo ""
  printf "  %-18s %-40s %s\n" "ALIAS" "PATH" "STATUS"
  printf "  %-18s %-40s %s\n" "─────" "────" "──────"
  for key in ${(ok)PROJECTS}; do
    local dir="${PROJECTS[$key]}"
    local sess_state=""
    if _has_window "$key"; then
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$key" -F "#{pane_current_command}" 2>/dev/null | head -1)
      if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
        sess_state="[claude]"
      else
        sess_state="[shell]"
      fi
    fi
    printf "  %-18s %-40s %s\n" "$key" "${dir/$HOME/~}" "$sess_state"
  done
  echo ""
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    echo "Windows in $ORCH_SESSION:"
    tmux list-windows -t "$ORCH_SESSION" -F "  #{window_index}: #{window_name} (#{pane_current_command})" 2>/dev/null
  else
    echo "Orchestra session not running."
  fi
}

_kill() {
  local name="$1"
  if _has_window "$name"; then
    tmux kill-window -t "$ORCH_SESSION:$name"
    echo "Killed window: $name"
  else
    echo "No window: $name"
  fi
}

_open() {
  local name="$1"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    echo "Run 'dev list' to see available projects"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  _ensure_session

  if _has_window "$name"; then
    if [[ -n "$TMUX" ]]; then
      tmux select-window -t "$ORCH_SESSION:$name"
    else
      tmux attach -t "$ORCH_SESSION:$name"
    fi
  else
    tmux new-window -t "$ORCH_SESSION" -n "$name" -c "$dir"
    if [[ -z "$TMUX" ]]; then
      tmux attach -t "$ORCH_SESSION:$name"
    fi
  fi
}

_claude() {
  local name="$1"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  cd "$dir" && claude
}

# Start Claude in a new window within the orchestra session
_start() {
  local name="$1"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  _require_claude || return 1
  _ensure_session || return 1

  # Auto-cleanup idle workers if system is under pressure
  _auto_cleanup 2>/dev/null

  # If window exists, check if Claude is running
  if _has_window "$name"; then
    local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
    if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
      echo "Already running: $name [claude]"
      return 0
    fi
    # Window exists but no Claude — attach logger then launch
    mkdir -p "$LOG_DIR"
    tmux pipe-pane -t "$ORCH_SESSION:$name" -o "cat >> '$LOG_DIR/${name}.log'"
    tmux send-keys -t "$ORCH_SESSION:$name" "'$CLAUDE_BIN' --dangerously-skip-permissions" Enter
    echo "Launched Claude in existing window: $name"
  else
    # Enforce session limit
    local active=$(_claude_count)
    if [[ $active -ge $MAX_CLAUDE_SESSIONS ]]; then
      echo "ERROR: Max $MAX_CLAUDE_SESSIONS active Claude sessions reached (current: $active)."
      echo "Kill one first: dev kill <project>"
      return 1
    fi

    tmux new-window -t "$ORCH_SESSION" -n "$name" -c "$dir"
    # Attach logger before launching Claude (captures all output)
    mkdir -p "$LOG_DIR"
    tmux pipe-pane -t "$ORCH_SESSION:$name" -o "cat >> '$LOG_DIR/${name}.log'"
    sleep 0.5
    tmux send-keys -t "$ORCH_SESSION:$name" "'$CLAUDE_BIN' --dangerously-skip-permissions" Enter
    echo "Started: $name -> ${dir/$HOME/~}"
  fi

  # Wait for Claude to be ready (poll for process, max 15s)
  local max_wait=15
  local waited=0
  while [[ $waited -lt $max_wait ]]; do
    local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
    [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && break
    sleep 1
    waited=$((waited + 1))
  done

  if [[ $waited -ge $max_wait ]]; then
    echo "WARNING: Claude may not be ready in $name (waited ${max_wait}s)"
  else
    local win_index=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":${name}$" | cut -d: -f1)
    _log_history "START $name [window $win_index]"
    echo "Ready: $name [window $win_index] — switch with Ctrl+A $win_index"
  fi
}

# Send a message to a Claude window
_send() {
  local name="$1"
  shift
  local msg="$*"

  # Validate project alias
  if [[ -z "${PROJECTS[$name]}" ]]; then
    echo "Unknown project: $name — run 'dev list'"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name — start with: dev start $name"
    return 1
  fi

  if [[ -z "$msg" ]]; then
    echo "Usage: dev send <project> <message>"
    return 1
  fi

  # Check that Claude is actually running
  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
  if [[ ! "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    echo "ERROR: $name is not running Claude (running: $pane_cmd). Start with: dev start $name"
    return 1
  fi

  # Flatten multi-line messages to single line
  # (Claude Code TUI collapses pasted multi-line text into "[Pasted text]" and won't send it)
  msg="${msg//$'\n'/ }"
  msg="${msg//$'\r'/ }"

  if [[ ${#msg} -gt 1000 ]]; then
    local tmpfile=$(mktemp)
    printf '%s' "$msg" > "$tmpfile"
    tmux load-buffer "$tmpfile" && \
      tmux paste-buffer -t "$ORCH_SESSION:$name" && \
      sleep 0.3 && \
      tmux send-keys -t "$ORCH_SESSION:$name" Enter || {
        echo "ERROR: Failed to send long message to $name"
        rm -f "$tmpfile"
        return 1
      }
    rm -f "$tmpfile"
  else
    tmux send-keys -l -t "$ORCH_SESSION:$name" "$msg"
    tmux send-keys -t "$ORCH_SESSION:$name" Enter
  fi

  _log_history "SEND $name: ${msg:0:200}"
  local win_index=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":${name}$" | cut -d: -f1)
  echo "Sent to $name [window $win_index]: ${msg:0:80}$([ ${#msg} -gt 80 ] && echo '...')"
}

# Show status of all active windows in the orchestra session
_status() {
  local found=0
  echo ""
  printf "  %-4s %-18s %-12s %s\n" "WIN" "PROJECT" "STATUS" "PATH"
  printf "  %-4s %-18s %-12s %s\n" "───" "───────" "──────" "────"

  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}|#{window_name}|#{pane_current_command}" 2>/dev/null)
    while IFS='|' read -r idx wname pcmd; do
      found=1
      local dir="${PROJECTS[$wname]}"
      [[ -z "$dir" ]] && dir="(orchestrator)"
      local sess_state="shell"
      [[ "$pcmd" =~ $CLAUDE_PROC_PATTERN ]] && sess_state="claude"
      printf "  %-4s %-18s %-12s %s\n" "$idx" "$wname" "[$sess_state]" "${dir/$HOME/~}"
    done <<< "$windows"
  fi

  [[ $found -eq 0 ]] && echo "  No active sessions. Start with: dev orchestra"
  echo ""
  echo "  Claude sessions: $(_claude_count)/$MAX_CLAUDE_SESSIONS"
  echo ""
}

# Broadcast message to all active Claude windows only
_broadcast() {
  local msg="$*"
  if [[ -z "$msg" ]]; then
    echo "Usage: dev broadcast <message>"
    return 1
  fi

  local count=0
  local skipped=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
        _send "$wname" "$msg"
        count=$((count + 1))
        sleep 0.2
      else
        skipped=$((skipped + 1))
      fi
    done <<< "$windows"
  fi
  echo "Broadcast to $count Claude sessions (skipped $skipped non-Claude windows)."
}

# Peek at a worker's recent output
_peek() {
  local name="$1"
  local lines="${2:-50}"
  [[ ! "$lines" =~ ^[0-9]+$ ]] && lines=50

  if [[ -z "$name" ]]; then
    echo "Usage: dev peek <project> [lines]"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name"
    return 1
  fi

  _log_history "PEEK $name"

  # Capture pane content and strip ANSI/TUI garbage
  # (capture-pane is cleaner than pipe-pane logs for reading)
  tmux capture-pane -t "$ORCH_SESSION:$name" -p -S "-$lines" | \
    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | \
    sed 's/\x1b\][^\x07]*\x07//g' | \
    tr -d '\xc2\xa0' | \
    sed 's/[[:cntrl:]]//g' | \
    grep -v '^[[:space:]]*$' | \
    tail -"$lines"
}

# Live tail of worker's log file
_watch() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: dev watch <project>"
    return 1
  fi

  local logfile="$LOG_DIR/${name}.log"
  if [[ ! -f "$logfile" ]]; then
    echo "No log file for $name — start the worker first: dev start $name"
    return 1
  fi

  echo "Watching $name (Ctrl+C to stop)..."
  tail -f "$logfile" | \
    sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | \
    sed 's/\x1b\][^\x07]*\x07//g' | \
    tr -d '\xc2\xa0' | \
    sed 's/[[:cntrl:]]//g'
}

# Show task history
_history() {
  local filter="$1"
  local lines="${2:-30}"

  if [[ ! -f "$HISTORY_FILE" ]]; then
    echo "No history yet."
    return 0
  fi

  if [[ -n "$filter" ]]; then
    grep -iF "$filter" "$HISTORY_FILE" | tail -"$lines"
  else
    tail -"$lines" "$HISTORY_FILE"
  fi
}

# Wait for a worker to finish, then notify
_wait() {
  local name="$1"
  local max_wait="${2:-300}"  # default 5 minutes

  if [[ -z "$name" ]]; then
    echo "Usage: dev wait <project> [timeout_seconds]"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name"
    return 1
  fi

  echo "Waiting for $name to finish (max ${max_wait}s)..."
  local waited=0
  local start_time=$(date +%s)

  while [[ $waited -lt $max_wait ]]; do
    _is_done "$name"
    local result=$?
    if [[ $result -eq 0 ]]; then
      local elapsed=$(($(date +%s) - start_time))
      _log_history "DONE $name (${elapsed}s)"
      _notify "$name" "Task complete (${elapsed}s)"
      echo "$name: done (${elapsed}s)"
      return 0
    elif [[ $result -eq 2 ]]; then
      echo "$name: Claude not running"
      return 2
    fi
    sleep 3
    waited=$((waited + 3))
  done

  _notify "$name" "Timed out after ${max_wait}s"
  echo "$name: timed out after ${max_wait}s"
  return 1
}

# Send a question and wait for response
_ask() {
  local name="$1"
  shift
  local msg="$*"
  local timeout=120  # 2 min default

  if [[ -z "$name" || -z "$msg" ]]; then
    echo "Usage: dev ask <project> <question>"
    return 1
  fi

  # Send the message
  _send "$name" "$msg" || return 1

  # Wait for completion
  echo "Waiting for $name to respond..."
  local waited=0
  sleep 5  # give Claude a moment to start processing

  while [[ $waited -lt $timeout ]]; do
    _is_done "$name"
    local result=$?
    if [[ $result -eq 0 ]]; then
      _log_history "ASK-DONE $name (${waited}s)"
      echo ""
      echo "--- Response from $name ---"
      _peek "$name" 30
      _notify "$name" "Response ready"
      return 0
    elif [[ $result -eq 2 ]]; then
      echo "$name: Claude not running"
      return 2
    fi
    sleep 3
    waited=$((waited + 3))
  done

  echo "$name: timed out waiting for response (${timeout}s)"
  echo "--- Partial output ---"
  _peek "$name" 20
  return 1
}

# Run a non-interactive task using claude --print
_run() {
  local name="$1"
  shift
  local msg="$*"

  if [[ -z "$name" || -z "$msg" ]]; then
    echo "Usage: dev run <project> <task>"
    return 1
  fi

  local dir="${PROJECTS[$name]}"
  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  local outfile="$LOG_DIR/${name}-run-$(date +%Y%m%d-%H%M%S).log"
  mkdir -p "$LOG_DIR"

  _log_history "RUN $name: ${msg:0:200}"
  echo "Running task in $name (non-interactive)..."
  echo "Output: $outfile"

  (
    cd "$dir" && "$CLAUDE_BIN" --print "$msg" > "$outfile" 2>&1
    local rc=$?
    if [[ $rc -eq 0 ]]; then
      _notify "$name" "Task finished"
      _log_history "RUN-DONE $name (exit 0)"
    else
      _notify "$name" "Task FAILED (exit $rc)"
      _log_history "RUN-FAILED $name (exit $rc)"
    fi
  ) &

  echo "Task running in background (PID: $!)"
  echo "Check output: cat $outfile"
}

# Recover crashed Claude sessions
_recover() {
  local target="$1"

  if [[ "$target" == "--all" ]]; then
    # Recover all crashed sessions
    local recovered=0
    if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
      local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}|#{pane_current_command}" 2>/dev/null)
      while IFS='|' read -r wname pcmd; do
        [[ "$wname" == "orchestra" ]] && continue
        [[ -z "${PROJECTS[$wname]}" ]] && continue
        if [[ ! "$pcmd" =~ $CLAUDE_PROC_PATTERN ]]; then
          echo "Recovering $wname..."
          tmux send-keys -t "$ORCH_SESSION:$wname" "'$CLAUDE_BIN' --dangerously-skip-permissions --resume" Enter
          recovered=$((recovered + 1))
          _log_history "RECOVER $wname"
        fi
      done <<< "$windows"
    fi
    echo "Recovered $recovered sessions."
    return 0
  fi

  if [[ -z "$target" ]]; then
    echo "Usage: dev recover <project> | dev recover --all"
    return 1
  fi

  if [[ -z "${PROJECTS[$target]}" ]]; then
    echo "Unknown project: $target"
    return 1
  fi

  if ! _has_window "$target"; then
    echo "No window for $target — start with: dev start $target"
    return 1
  fi

  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
  if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    echo "$target: Claude is already running"
    return 0
  fi

  echo "Recovering $target with --resume..."
  tmux send-keys -t "$ORCH_SESSION:$target" "'$CLAUDE_BIN' --dangerously-skip-permissions --resume" Enter
  _log_history "RECOVER $target"

  # Wait for readiness
  local max_wait=15
  local waited=0
  while [[ $waited -lt $max_wait ]]; do
    pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
    [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && break
    sleep 1
    waited=$((waited + 1))
  done

  if [[ $waited -ge $max_wait ]]; then
    echo "WARNING: Claude may not be ready in $target"
  else
    echo "Recovered: $target"
    _notify "$target" "Session recovered"
  fi
}

# Start orchestrator: create master session, open Claude in window 0
_orchestra() {
  _require_claude || return 1
  _ensure_session || return 1

  # Launch Claude BEFORE attaching (attach is blocking)
  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:orchestra" -F "#{pane_current_command}" 2>/dev/null | head -1)
  if [[ ! "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    tmux send-keys -t "$ORCH_SESSION:orchestra" "cd '$ORCH_DIR' && '$CLAUDE_BIN' --dangerously-skip-permissions" Enter
  fi

  # Now attach/switch (blocking — nothing runs after this until detach)
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$ORCH_SESSION:orchestra"
  else
    tmux attach -t "$ORCH_SESSION:orchestra"
  fi
}

case "$1" in
  list|ls)        _list ;;
  kill)           _kill "$2" ;;
  claude|cc)      _claude "$2" ;;
  start)          _start "$2" ;;
  send)           _send "$2" "${@:3}" ;;
  status)         _status ;;
  health)         _health ;;
  state)          _state "$2" "$3" "$4" "${@:5}" ;;
  analyze)        _analyze "$2" ;;
  cleanup)
    if [[ "$2" == "--confirm" ]]; then
      _cleanup_confirmed
    else
      _auto_cleanup --force
    fi
    ;;
  broadcast)      _broadcast "${@:2}" ;;
  orchestra|orch|o) _orchestra ;;
  peek)           _peek "$2" "$3" ;;
  watch)          _watch "$2" ;;
  history)        _history "$2" "$3" ;;
  wait)           _wait "$2" "$3" ;;
  ask)            _ask "$2" "${@:3}" ;;
  run)            _run "$2" "${@:3}" ;;
  recover)        _recover "$2" ;;
  notify)         _notify "$2" "${@:3}" ;;
  done)           _done "$2" ;;
  add)            _add "$2" "$3" ;;
  remove|rm)      _remove "$2" ;;
  help|-h)
    echo "Usage:"
    echo "  dev                        Start orchestrator (shortcut)"
    echo "  dev orchestra              Start orchestrator (master session)"
    echo "  dev start <project>        Start Claude in a window (max $MAX_CLAUDE_SESSIONS)"
    echo "  dev send <project> <msg>   Send message to project's Claude"
    echo "  dev peek <project> [lines] Read worker's recent output"
    echo "  dev broadcast <msg>        Send to all active Claude sessions"
    echo "  dev status                 Show all windows and their status"
    echo "  dev list                   List all projects"
    echo "  dev add <alias> <path>     Add a project"
    echo "  dev remove <alias>         Remove a project"
    echo "  dev watch <project>        Live tail of worker's log"
    echo "  dev history [alias] [n]    Show recent task history"
    echo "  dev wait <project> [sec]   Wait for worker to finish, then notify"
    echo "  dev ask <project> <msg>    Send question, wait for response, show it"
    echo "  dev run <project> <task>   Run non-interactive task (claude --print)"
    echo "  dev recover <project>     Recover crashed session (claude --resume)"
    echo "  dev recover --all         Recover all crashed sessions"
    echo "  dev done <project>         Check if worker is idle or working"
    echo "  dev notify <title> <msg>   Send a desktop notification (macOS + Linux)"
    echo "  dev kill <project>         Kill a project window"
    echo "  dev cc <project>           Open Claude Code directly in project"
    echo "  dev <project>              Open project shell in a window"
    echo "  dev help                   Show this help"
    ;;
  "")             _orchestra ;;
  *)              _open "$1" ;;
esac
