        echo "  dev kimi done <project>    Check if Kimi is idle"
        echo "  dev kimi recover <p>       Recover crashed Kimi session"
        ;;
    esac
    ;;
  codex)
    # Codex subcommands
    case "$2" in
      start)      _start_codex "$3" ;;
      send)       _send "$3" "${@:4}" ;;
      peek)       _peek "$3" "$4" ;;
      status)     _status ;;
      broadcast)  _broadcast "${@:3}" ;;
      watch)      _watch "$3" ;;
      wait)       _wait "$3" "$4" ;;
      ask)        _ask "$3" "${@:4}" ;;
      done)       _done "$3" ;;
      recover)    _recover "$3" ;;
      "")         ORCHESTRA_AI=codex _orchestra ;;  # Start Codex orchestrator
