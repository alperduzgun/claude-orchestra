  repo_root=$(_find_repo_root)
  if [[ -n "$repo_root" && -d "$repo_root/orchestrator" ]]; then
    local f
    for f in "${files[@]}"; do
      if [[ -f "$repo_root/orchestrator/$f" && ! -f "$ORCH_DIR/$f" ]]; then
        cp "$repo_root/orchestrator/$f" "$ORCH_DIR/$f"
