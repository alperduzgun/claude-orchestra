# Send a message to an AI window (Claude, Kimi, Codex, or Forge)
_send() {
  local name=""
  local target="left"
  local msg_parts=()

  # Parse: dev send <project> [--qwen|--right|--left|--opencode] <message>
  for arg in "$@"; do
    if [[ "$arg" == "--qwen" || "$arg" == "--right" || "$arg" == "--opencode" || "$arg" == "--gemini" ]]; then
      target="right"
    elif [[ "$arg" == "--left" ]]; then
      target="left"
    elif [[ -z "$name" ]]; then
      name="$arg"
    else
      msg_parts+=("$arg")
    fi
  done

  local msg="${msg_parts[*]}"

  # Validate project alias
  if [[ -z "${PROJECTS[$name]}" ]]; then
    echo "Unknown project: $name — run 'dev list'"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name — start with: dev start $name"
    return 1
  fi

  if [[ -z "$msg" ]]; then
    echo "Usage: dev send <project> [--qwen] <message>"
    return 1
  fi

  # Determine target pane
  local pane_target
  pane_target=$(_pane_target_for_side "$name" "$target") || {
    echo "ERROR: Failed to resolve $target pane for $name"
    return 1
  }

  # Detect which AI is actually running in the target pane (for logging).
  local pane_idx
  pane_idx=$(_pane_index_for_side "$name" "$target") || pane_idx=""
  local ai_label=$(_detect_pane_ai "$name" "$pane_idx")
  [[ -z "$ai_label" ]] && ai_label="unknown"
  local ai_type="$ai_label"

  # Flatten multi-line messages to single line
  # (Both AI TUIs collapse pasted multi-line text into "[Pasted text]" and won't send it)
  msg="${msg//$'\n'/ }"
  msg="${msg//$'\r'/ }"

  if [[ ${#msg} -gt 1000 ]]; then
    local tmpfile=$(mktemp)
    printf '%s' "$msg" > "$tmpfile"
    tmux load-buffer "$tmpfile" && \
      tmux paste-buffer -t "$pane_target" && \
      sleep 0.3 && \
      tmux send-keys -t "$pane_target" Enter || {
        echo "ERROR: Failed to send long message to $name"
        rm -f "$tmpfile"
        return 1
      }
    rm -f "$tmpfile"
  else
    tmux send-keys -l -t "$pane_target" "$msg"
    sleep 0.2
    tmux send-keys -t "$pane_target" Enter
  fi

  _log_history "SEND $name [$ai_label]: ${msg:0:200}"
  local win_index=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":${name}$" | cut -d: -f1)
  echo "Sent to $name [$ai_label] [window $win_index]: ${msg:0:80}$([ ${#msg} -gt 80 ] && echo '...')"
}

# Show status of all active windows in the orchestra session
_status() {
  local found=0
  echo ""
  printf "  %-4s %-18s %-12s %s\n" "WIN" "PROJECT" "STATUS" "PATH"
  printf "  %-4s %-18s %-12s %s\n" "───" "───────" "──────" "────"

  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}|#{window_name}|#{pane_current_command}" 2>/dev/null)
    while IFS='|' read -r idx wname pcmd; do
      found=1
      local dir="${PROJECTS[$wname]}"
      [[ -z "$dir" ]] && dir="(orchestrator)"
      local sess_state="shell"
      if [[ "$pcmd" =~ $CLAUDE_PROC_PATTERN ]]; then
        sess_state="claude"
      elif [[ "$pcmd" =~ ^python ]] || [[ "$pcmd" == "kimi" ]]; then
        sess_state="kimi"
      elif [[ "$pcmd" =~ $CODEX_PROC_PATTERN ]]; then
        sess_state="codex"
      elif [[ "$pcmd" =~ $FORGE_PROC_PATTERN ]]; then
        sess_state="forge"
      elif [[ "$pcmd" =~ $OPENCODE_PROC_PATTERN ]]; then
        sess_state="opencode"
      elif [[ "$pcmd" =~ $GEMINI_PROC_PATTERN ]] || [[ "$pcmd" =~ $GEMINI_FULL_PROC_PATTERN ]]; then
        sess_state="gemini"
      fi
      printf "  %-4s %-18s %-12s %s\n" "$idx" "$wname" "[$sess_state]" "${dir/$HOME/~}"
    done <<< "$windows"
  fi

  [[ $found -eq 0 ]] && echo "  No active sessions. Start with: dev orchestra"
  echo ""
  local claude_count=$(_claude_count)
  local kimi_count=$(_kimi_count)
  local codex_count=$(_codex_count)
  local forge_count=$(_forge_count)
  echo "  Claude sessions: $claude_count | Kimi sessions: $kimi_count | Codex sessions: $codex_count | Forge sessions: $forge_count | Max: $MAX_AI_SESSIONS"
  echo ""
}

# Broadcast message to all active AI windows (Claude and Kimi)
_broadcast() {
  local msg="$*"
  if [[ -z "$msg" ]]; then
    echo "Usage: dev broadcast <message>"
    return 1
  fi

  local claude_count=0
  local kimi_count=0
  local codex_count=0
  local forge_count=0
  local opencode_count=0
  local gemini_count=0
  local skipped=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      local is_ai=false
      if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
        is_ai=true
        claude_count=$((claude_count + 1))
      elif [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
        is_ai=true
        kimi_count=$((kimi_count + 1))
      elif [[ "$pane_cmd" =~ $CODEX_PROC_PATTERN ]]; then
        is_ai=true
        codex_count=$((codex_count + 1))
      elif [[ "$pane_cmd" =~ $FORGE_PROC_PATTERN ]]; then
        is_ai=true
        forge_count=$((forge_count + 1))
      elif [[ "$pane_cmd" =~ $OPENCODE_PROC_PATTERN ]]; then
        is_ai=true
        opencode_count=$((opencode_count + 1))
      elif [[ "$pane_cmd" =~ $GEMINI_PROC_PATTERN ]] || [[ "$pane_cmd" =~ $GEMINI_FULL_PROC_PATTERN ]]; then
        is_ai=true
        gemini_count=$((gemini_count + 1))
      fi
      
      if [[ "$is_ai" == true ]]; then
        _send "$wname" "$msg"
        sleep 0.2
      else
        skipped=$((skipped + 1))
      fi
    done <<< "$windows"
  fi
  local total=$((claude_count + kimi_count + codex_count + forge_count + opencode_count + gemini_count))
  echo "Broadcast to $total AI sessions (Claude: $claude_count, Kimi: $kimi_count, Codex: $codex_count, Forge: $forge_count, opencode: $opencode_count, gemini: $gemini_count, skipped: $skipped)."
}

# Peek at a worker's recent output
_peek() {
  local name=""
  local target="left"
  local lines="50"
  local source="auto"
  local raw=false

  for arg in "$@"; do
    if [[ "$arg" == "--qwen" || "$arg" == "--right" || "$arg" == "--opencode" || "$arg" == "--gemini" ]]; then
      target="right"
    elif [[ "$arg" == "--left" ]]; then
      target="left"
    elif [[ "$arg" == "--log" ]]; then
      source="log"
    elif [[ "$arg" == "--screen" ]]; then
      source="screen"
    elif [[ "$arg" == "--raw" ]]; then
      raw=true
    elif [[ -z "$name" ]]; then
      name="$arg"
    elif [[ "$arg" =~ ^[0-9]+$ ]]; then
      lines="$arg"
    fi
  done

  if [[ -z "$name" ]]; then
    echo "Usage: dev peek <project> [--qwen|--right|--left|--opencode] [--screen] [--raw] [lines]"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name"
    return 1
  fi

  local pane_target
  pane_target=$(_pane_target_for_side "$name" "$target") || {
    echo "ERROR: Failed to resolve $target pane for $name"
    return 1
  }

  _log_history "PEEK $name [$target]"

  local pane_logfile="$(_pane_logfile_for_side "$name" "$target")"
  local window_logfile="$(_window_logfile "$name")"
  local logfile="$pane_logfile"

  if [[ "$source" == "auto" ]]; then
    if [[ -f "$pane_logfile" ]]; then
      source="log"
    else
      source="screen"
    fi
  fi

  if [[ "$source" == "log" && ! -f "$logfile" ]]; then
    if [[ -f "$window_logfile" ]]; then
      logfile="$window_logfile"
    else
      source="screen"
    fi
  fi

  if [[ "$source" == "log" && -f "$logfile" ]]; then
    if [[ "$raw" == true ]]; then
      tail -n "$lines" "$logfile"
    else
      tail -n "$lines" "$logfile" | _clean_terminal_output
    fi
    return 0
  fi

  if [[ "$raw" == true ]]; then
    tmux capture-pane -J -t "$pane_target" -p -S "-$lines"
  else
    tmux capture-pane -J -t "$pane_target" -p -S "-$lines" | \
      _clean_terminal_output | \
      grep -v '^[[:space:]]*$' | \
      tail -"$lines"
  fi
}

# Live tail of worker's log file
_watch() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: dev watch <project>"
    return 1
  fi

  local logfile="$LOG_DIR/${name}.log"
  if [[ ! -f "$logfile" ]]; then
    echo "No log file for $name — start the worker first: dev start $name"
    return 1
  fi

  echo "Watching $name (Ctrl+C to stop)..."
  tail -f "$logfile" | \
    sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | \
    sed 's/\x1b\][^\x07]*\x07//g' | \
    tr -d '\xc2\xa0' | \
    sed 's/[[:cntrl:]]//g'
}

# Show task history
_history() {
  local filter="$1"
  local lines="${2:-30}"

  if [[ ! -f "$HISTORY_FILE" ]]; then
    echo "No history yet."
    return 0
  fi

  if [[ -n "$filter" ]]; then
    grep -iF "$filter" "$HISTORY_FILE" | tail -"$lines"
  else
    tail -"$lines" "$HISTORY_FILE"
  fi
}

# Wait for a worker to finish, then notify
_wait() {
  local name="$1"
  local max_wait="${2:-300}"  # default 5 minutes

  if [[ -z "$name" ]]; then
    echo "Usage: dev wait <project> [timeout_seconds]"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name"
    return 1
  fi

  echo "Waiting for $name to finish (max ${max_wait}s)..."
  local waited=0
  local start_time=$(date +%s)

  while [[ $waited -lt $max_wait ]]; do
    _is_done "$name"
    local result=$?
    if [[ $result -eq 0 ]]; then
      local elapsed=$(($(date +%s) - start_time))
      _log_history "DONE $name (${elapsed}s)"
      _notify "$name" "Task complete (${elapsed}s)"
      echo "$name: done (${elapsed}s)"
      return 0
    elif [[ $result -eq 2 ]]; then
      echo "$name: Claude not running"
      return 2
    fi
    sleep 3
    waited=$((waited + 3))
  done

  _notify "$name" "Timed out after ${max_wait}s"
  echo "$name: timed out after ${max_wait}s"
  return 1
}

# Send a question and wait for response
_ask() {
  local name="$1"
  shift
  local msg="$*"
  local timeout=120  # 2 min default

  if [[ -z "$name" || -z "$msg" ]]; then
    echo "Usage: dev ask <project> <question>"
    return 1
  fi

  # Send the message
  _send "$name" "$msg" || return 1

  # Wait for completion
  echo "Waiting for $name to respond..."
  local waited=0
  sleep 5  # give Claude a moment to start processing

  while [[ $waited -lt $timeout ]]; do
    _is_done "$name"
    local result=$?
    if [[ $result -eq 0 ]]; then
      _log_history "ASK-DONE $name (${waited}s)"
      echo ""
      echo "--- Response from $name ---"
      _peek "$name" 30
      _notify "$name" "Response ready"
      return 0
    elif [[ $result -eq 2 ]]; then
      echo "$name: Claude not running"
      return 2
    fi
    sleep 3
    waited=$((waited + 3))
  done

  echo "$name: timed out waiting for response (${timeout}s)"
  echo "--- Partial output ---"
  _peek "$name" 20
  return 1
}

# Run a non-interactive task using claude --print
_run() {
  local name="$1"
  shift
  local msg="$*"

  if [[ -z "$name" || -z "$msg" ]]; then
    echo "Usage: dev run <project> <task>"
    return 1
  fi

  local dir="${PROJECTS[$name]}"
  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  local outfile="$LOG_DIR/${name}-run-$(date +%Y%m%d-%H%M%S).log"
  mkdir -p "$LOG_DIR"

  _log_history "RUN $name: ${msg:0:200}"
  echo "Running task in $name (non-interactive)..."
  echo "Output: $outfile"

  (
    unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
    cd "$dir" && "$CLAUDE_BIN" --print "$msg" > "$outfile" 2>&1
    local rc=$?
    if [[ $rc -eq 0 ]]; then
      _notify "$name" "Task finished"
      _log_history "RUN-DONE $name (exit 0)"
    else
      _notify "$name" "Task FAILED (exit $rc)"
      _log_history "RUN-FAILED $name (exit $rc)"
    fi
  ) &

  echo "Task running in background (PID: $!)"
  echo "Check output: cat $outfile"
}

# Recover crashed AI sessions
_recover() {
  local target="$1"

  if [[ "$target" == "--all" ]]; then
    # Recover all crashed sessions
    local claude_recovered=0
    local kimi_recovered=0
    local codex_recovered=0
    local forge_recovered=0
    if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
      local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}|#{pane_current_command}" 2>/dev/null)
      while IFS='|' read -r wname pcmd; do
        [[ "$wname" == "orchestra" ]] && continue
        [[ -z "${PROJECTS[$wname]}" ]] && continue
        
        # Check current AI type and recover accordingly
        if [[ ! "$pcmd" =~ $CLAUDE_PROC_PATTERN ]] && [[ ! "$pcmd" =~ ^python ]] && [[ "$pcmd" != "kimi" ]] && [[ ! "$pcmd" =~ $CODEX_PROC_PATTERN ]] && [[ ! "$pcmd" =~ $FORGE_PROC_PATTERN ]] && [[ ! "$pcmd" =~ $OPENCODE_PROC_PATTERN ]]; then
          # Window exists but no AI running - determine which AI was there
          local tracked_ai=$(_get_ai_type "$wname")
          local dir="${PROJECTS[$wname]}"
          
          if [[ "$tracked_ai" == "codex" ]]; then
            echo "Recovering $wname [codex]..."
            tmux send-keys -t "$ORCH_SESSION:$wname" "cd '$dir' && $(_worker_launch_cmd codex)" Enter
            codex_recovered=$((codex_recovered + 1))
            _log_history "RECOVER-CODEX $wname"
          elif [[ "$tracked_ai" == "forge" ]]; then
            echo "Recovering $wname [forge]..."
            tmux send-keys -t "$ORCH_SESSION:$wname" "cd '$dir' && $(_worker_launch_cmd forge)" Enter
            _send_worker_bootstrap_if_needed "$ORCH_SESSION:$wname" "forge"
            forge_recovered=$((forge_recovered + 1))
            _log_history "RECOVER-FORGE $wname"
          elif [[ "$tracked_ai" == "kimi" ]] || [[ -z "$tracked_ai" && -x "$KIMI_BIN" ]]; then
            echo "Recovering $wname [kimi]..."
            tmux send-keys -t "$ORCH_SESSION:$wname" "cd '$dir' && $(_worker_launch_cmd kimi)" Enter
            _send_worker_bootstrap_if_needed "$ORCH_SESSION:$wname" "kimi"
            kimi_recovered=$((kimi_recovered + 1))
            _log_history "RECOVER-KIMI $wname"
          else
            echo "Recovering $wname [claude]..."
            tmux send-keys -t "$ORCH_SESSION:$wname" "cd '$dir' && $(_worker_launch_cmd claude) --resume" Enter
            claude_recovered=$((claude_recovered + 1))
            _log_history "RECOVER $wname"
          fi
        fi
      done <<< "$windows"
    fi
    echo "Recovered $((claude_recovered + kimi_recovered + codex_recovered + forge_recovered)) sessions (Claude: $claude_recovered, Kimi: $kimi_recovered, Codex: $codex_recovered, Forge: $forge_recovered)."
    return 0
  fi

  if [[ -z "$target" ]]; then
    echo "Usage: dev recover <project> | dev recover --all"
    return 1
  fi

  if [[ -z "${PROJECTS[$target]}" ]]; then
    echo "Unknown project: $target"
    return 1
  fi

  if ! _has_window "$target"; then
    echo "No window for $target — start with: dev start $target"
    return 1
  fi

  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
  local dir="${PROJECTS[$target]}"
  local tracked_ai=$(_get_ai_type "$target")
  
  # Check if already running
  if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    echo "$target: Claude is already running"
    return 0
  fi
  if [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
    echo "$target: Kimi is already running"
    return 0
  fi
  if [[ "$pane_cmd" =~ $CODEX_PROC_PATTERN ]]; then
    echo "$target: Codex is already running"
    return 0
  fi
  if [[ "$pane_cmd" =~ $FORGE_PROC_PATTERN ]]; then
    echo "$target: Forge is already running"
    return 0
  fi

  # Determine which AI to recover
  if [[ "$tracked_ai" == "kimi" ]]; then
    echo "Recovering $target [kimi]..."
    tmux send-keys -t "$ORCH_SESSION:$target" "cd '$dir' && $(_worker_launch_cmd kimi)" Enter
    _send_worker_bootstrap_if_needed "$ORCH_SESSION:$target" "kimi"
    _log_history "RECOVER-KIMI $target"

    local max_wait=15
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
      pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ ^python ]] && break
      [[ "$pane_cmd" == "kimi" ]] && break
      sleep 1
      waited=$((waited + 1))
    done

    if [[ $waited -ge $max_wait ]]; then
      echo "WARNING: Kimi may not be ready in $target"
    else
      echo "Recovered: $target [kimi]"
      _notify "$target" "Kimi session recovered"
    fi
  elif [[ "$tracked_ai" == "codex" ]]; then
    echo "Recovering $target [codex]..."
    tmux send-keys -t "$ORCH_SESSION:$target" "cd '$dir' && $(_worker_launch_cmd codex)" Enter
    _log_history "RECOVER-CODEX $target"

    local max_wait=15
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
      pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ $CODEX_PROC_PATTERN ]] && break
      sleep 1
      waited=$((waited + 1))
    done

    if [[ $waited -ge $max_wait ]]; then
      echo "WARNING: Codex may not be ready in $target"
    else
      echo "Recovered: $target [codex]"
      _notify "$target" "Codex session recovered"
    fi
  elif [[ "$tracked_ai" == "forge" ]]; then
    echo "Recovering $target [forge]..."
    tmux send-keys -t "$ORCH_SESSION:$target" "cd '$dir' && $(_worker_launch_cmd forge)" Enter
    _send_worker_bootstrap_if_needed "$ORCH_SESSION:$target" "forge"
    _log_history "RECOVER-FORGE $target"

    local max_wait=15
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
      pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ $FORGE_PROC_PATTERN ]] && break
      sleep 1
      waited=$((waited + 1))
    done

    if [[ $waited -ge $max_wait ]]; then
      echo "WARNING: Forge may not be ready in $target"
    else
      echo "Recovered: $target [forge]"
      _notify "$target" "Forge session recovered"
    fi
  else
    echo "Recovering $target [claude]..."
    tmux send-keys -t "$ORCH_SESSION:$target" "cd '$dir' && $(_worker_launch_cmd claude) --resume" Enter
    _log_history "RECOVER $target"

    local max_wait=15
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
      pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && break
      sleep 1
      waited=$((waited + 1))
    done

    if [[ $waited -ge $max_wait ]]; then
      echo "WARNING: Claude may not be ready in $target"
    else
      echo "Recovered: $target [claude]"
      _notify "$target" "Session recovered"
    fi
  fi
}

# Start orchestrator: create master session, open Claude, Kimi, or Codex in window 0
_orchestra() {
  _ensure_session || return 1
  _ensure_orchestrator_prompt_files || return 1

  # Check which orchestrator to use (default: Claude)
  local orch_ai="${ORCHESTRA_AI:-claude}"
  case "$orch_ai" in
    codex) _require_codex || return 1 ;;
    kimi)  _require_kimi || return 1 ;;
    forge) _require_forge || return 1 ;;
    *)     _require_claude || return 1 ;;
  esac

  # Check what's currently running in orchestra window
  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:orchestra" -F "#{pane_current_command}" 2>/dev/null | head -1)
  local current_ai=""
  
  # Detect current AI type
  if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    current_ai="claude"
  elif [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
    current_ai="kimi"
  elif [[ "$pane_cmd" =~ $CODEX_PROC_PATTERN ]]; then
    current_ai="codex"
  elif [[ "$pane_cmd" =~ $FORGE_PROC_PATTERN ]]; then
    current_ai="forge"
  elif [[ "$pane_cmd" =~ $OPENCODE_PROC_PATTERN ]]; then
    current_ai="opencode"
  elif [[ "$pane_cmd" =~ $GEMINI_PROC_PATTERN ]] || [[ "$pane_cmd" =~ $GEMINI_FULL_PROC_PATTERN ]]; then
    current_ai="gemini"
  fi

  # If a different AI is running, kill it first
  if [[ -n "$current_ai" && "$current_ai" != "$orch_ai" ]]; then
    echo "Switching orchestrator from $current_ai to $orch_ai..."
    tmux send-keys -t "$ORCH_SESSION:orchestra" C-c
    sleep 0.5
    tmux send-keys -t "$ORCH_SESSION:orchestra" C-d
    sleep 0.2
    current_ai=""
  fi

  # Save orchestrator AI type
  _set_orchestrator_ai "$orch_ai"

  # Launch AI if not already running
  if [[ "$current_ai" != "$orch_ai" ]]; then
    if [[ "$orch_ai" == "kimi" ]]; then
      tmux send-keys -t "$ORCH_SESSION:orchestra" "$(_orchestrator_launch_cmd kimi)" Enter
      _send_orchestrator_bootstrap_if_needed "$ORCH_SESSION:orchestra" "kimi"
      echo "Starting Kimi orchestrator..."
    elif [[ "$orch_ai" == "codex" ]]; then
      tmux send-keys -t "$ORCH_SESSION:orchestra" "$(_orchestrator_launch_cmd codex)" Enter
      echo "Starting Codex orchestrator..."
    elif [[ "$orch_ai" == "forge" ]]; then
      tmux send-keys -t "$ORCH_SESSION:orchestra" "$(_orchestrator_launch_cmd forge)" Enter
      _send_orchestrator_bootstrap_if_needed "$ORCH_SESSION:orchestra" "forge"
      echo "Starting Forge orchestrator..."
    else
      tmux send-keys -t "$ORCH_SESSION:orchestra" "$(_orchestrator_launch_cmd claude)" Enter
      echo "Starting Claude orchestrator..."
    fi
    sleep 1
  else
    echo "$orch_ai orchestrator already running."
  fi

  # Now attach/switch (blocking — nothing runs after this until detach)
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$ORCH_SESSION:orchestra"
  else
    tmux attach -t "$ORCH_SESSION:orchestra"
  fi
}

case "$1" in
  list|ls)        _list ;;
  kill)           _kill "$2" ;;
  claude|cc)      _claude "$2" ;;
  start)          _start "${@:2}" ;;
  kimi)
    # Kimi subcommands
    case "$2" in
      start)      _start_kimi "$3" ;;
      send)       _send "$3" "${@:4}" ;;
      peek)       _peek "$3" "$4" ;;
      status)     _status ;;
      broadcast)  _broadcast "${@:3}" ;;
      watch)      _watch "$3" ;;
      wait)       _wait "$3" "$4" ;;
      ask)        _ask "$3" "${@:4}" ;;
      done)       _done "$3" ;;
      recover)    _recover "$3" ;;
      "")         ORCHESTRA_AI=kimi _orchestra ;;  # Start Kimi orchestrator
      *)
        echo "Kimi commands:"
