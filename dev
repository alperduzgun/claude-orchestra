#!/usr/bin/env zsh
# Dev - Project launcher & Claude Code / Kimi CLI / Forge Code / opencode orchestrator
# Usage: dev <project> | dev list | dev start <project> | dev send <project> "msg"
# Requires: zsh, tmux, Claude Code (https://docs.anthropic.com/en/docs/claude-code) or Kimi CLI (https://github.com/moonshot-ai/kimi-cli) or Forge Code (https://github.com/tailcallhq/forgecode) or opencode (https://opencode.ai)

# Clear nested Claude Code detection
unset CLAUDECODE

# Dependency check
if ! command -v tmux &>/dev/null; then
  echo "ERROR: tmux is required but not found. Install it first."
  exit 1
fi

ORCHESTRA_VERSION="v1.4.3"
ORCHESTRA_REPO_URL="https://github.com/alperduzgun/claude-orchestra"

# Config
CONFIG_DIR="${ORCHESTRA_CONFIG_DIR:-$HOME/.config/orchestra}"
PROJECTS_FILE="$CONFIG_DIR/projects.conf"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
KIMI_BIN="${KIMI_BIN:-$(command -v kimi 2>/dev/null || echo "$HOME/.local/bin/kimi")}"
CODEX_BIN="${CODEX_BIN:-$(command -v codex 2>/dev/null || echo "$HOME/.local/bin/codex")}"
FORGE_BIN="${FORGE_BIN:-$(command -v forge 2>/dev/null || echo "$HOME/.local/bin/forge")}"
OPENCODE_BIN="${OPENCODE_BIN:-$(command -v opencode 2>/dev/null || echo "$HOME/.local/bin/opencode")}"
GEMINI_BIN="${GEMINI_BIN:-$(command -v gemini 2>/dev/null || echo "$HOME/.local/bin/gemini")}"

# AI window tracking file (stores which AI is running in each window)
AI_TRACK_FILE="$CONFIG_DIR/.ai_windows"

# Validate CLAUDE_BIN before any tmux send-keys usage (prevents injection)
_require_claude() {
  if [[ ! -x "$CLAUDE_BIN" ]]; then
    echo "ERROR: Claude binary not found or not executable: $CLAUDE_BIN"
    echo "Install Claude Code: https://docs.anthropic.com/en/docs/claude-code"
    return 1
  fi
}

# Validate KIMI_BIN
_require_kimi() {
  if [[ ! -x "$KIMI_BIN" ]]; then
    echo "ERROR: Kimi binary not found or not executable: $KIMI_BIN"
    echo "Install Kimi CLI: https://github.com/moonshot-ai/kimi-cli"
    return 1
  fi
}

# Validate CODEX_BIN
_require_codex() {
  if [[ ! -x "$CODEX_BIN" ]]; then
    echo "ERROR: Codex binary not found or not executable: $CODEX_BIN"
    echo "Install Codex CLI: npm install -g @openai/codex"
    return 1
  fi
}

# Validate FORGE_BIN
_require_forge() {
  if [[ ! -x "$FORGE_BIN" ]]; then
    echo "ERROR: Forge binary not found or not executable: $FORGE_BIN"
    echo "Install Forge Code: https://github.com/tailcallhq/forgecode"
    return 1
  fi
}

# Validate OPENCODE_BIN
_require_opencode() {
  if [[ ! -x "$OPENCODE_BIN" ]]; then
    echo "ERROR: opencode binary not found or not executable: $OPENCODE_BIN"
    echo "Install opencode: https://opencode.ai"
    return 1
  fi
}

# Validate GEMINI_BIN
_require_gemini() {
  if [[ ! -x "$GEMINI_BIN" ]]; then
    echo "ERROR: gemini binary not found or not executable: $GEMINI_BIN"
    echo "Install Gemini CLI: https://ai.google.dev/gemini-cli/docs"
    return 1
  fi
}
ORCH_SESSION="${ORCHESTRA_SESSION:-devenv}"
# ORCH_DIR: dedicated orchestrator prompt directory
# Override with ORCHESTRA_DIR env var or set in ~/.config/orchestra/orchestra.conf
ORCH_DIR="${ORCHESTRA_DIR:-$CONFIG_DIR/orchestrator}"
MAX_CLAUDE_SESSIONS="${MAX_CLAUDE_SESSIONS:-10}"
MAX_KIMI_SESSIONS="${MAX_KIMI_SESSIONS:-10}"
MAX_AI_SESSIONS="${MAX_AI_SESSIONS:-10}"
# Claude Code sets its process title to its version (e.g., "2.1.72"), not "node"
CLAUDE_PROC_PATTERN="^[0-9]+\.[0-9]+\.[0-9]+$"
# Kimi CLI process detection (Python process with kimi module)
KIMI_PROC_PATTERN="(kimi|python.*kimi)"
# Codex CLI runs as a node process
CODEX_PROC_PATTERN="^node$"
# Forge Code is a native binary
FORGE_PROC_PATTERN="^forge$"
# opencode is a native binary
OPENCODE_PROC_PATTERN="^opencode$"
# Gemini CLI is a Node.js app (runs as 'node' with gemini arg)
GEMINI_PROC_PATTERN="gemini"
# But we need to distinguish from codex - check the full command
GEMINI_FULL_PROC_PATTERN="node.*gemini"
LOG_DIR="${HOME}/.local/share/orchestra/logs"
HISTORY_FILE="${HOME}/.local/share/orchestra/history.log"

# Log an action to history file
_log_history() {
  mkdir -p "$(dirname "$HISTORY_FILE")"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$HISTORY_FILE"
}

# Desktop notification helper (macOS + Linux)
# Silenced when ORCHESTRA_NOTIFY ∈ {0, false, no, off} (case-insensitive)
_notify() {
  case "${ORCHESTRA_NOTIFY:-1}" in
    0|false|False|FALSE|no|No|NO|off|Off|OFF) return 0 ;;
  esac
  local title="${1:-Orchestra}"
  local msg="${2:-Task complete}"
  if command -v osascript &>/dev/null; then
    osascript - "$title" "$msg" <<'APPLESCRIPT' 2>/dev/null
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
  elif command -v notify-send &>/dev/null; then
    notify-send "$title" "$msg" 2>/dev/null
  fi
}

# Load projects from config file
typeset -A PROJECTS
_load_projects() {
  if [[ ! -f "$PROJECTS_FILE" ]]; then
    echo "No projects configured. Run: dev add <alias> /path/to/project"
    echo "Config: $PROJECTS_FILE"
    return 1
  fi
  while IFS='=' read -r key val; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    key="${key## }"; key="${key%% }"
    val="${val## }"; val="${val%% }"
    # Expand ~ and $HOME
    val="${val/#\~/$HOME}"
    val="${val/\$HOME/$HOME}"
    PROJECTS[$key]="$val"
  done < "$PROJECTS_FILE"
}

_load_projects

# Add a project to config
_add() {
  local alias="$1"
  local dir="$2"

  if [[ -z "$alias" || -z "$dir" ]]; then
    echo "Usage: dev add <alias> /path/to/project"
    return 1
  fi

  # Validate alias: only alphanumeric, hyphens, underscores
  if [[ ! "$alias" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Invalid alias: use only letters, numbers, hyphens, underscores"
    return 1
  fi

  # Resolve to absolute path
  dir="${dir/#\~/$HOME}"
  [[ ! "$dir" = /* ]] && dir="$(cd "$dir" 2>/dev/null && pwd)"

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  if [[ -n "${PROJECTS[$alias]}" ]]; then
    echo "Alias '$alias' already exists: ${PROJECTS[$alias]}"
    echo "Remove first with: dev remove $alias"
    return 1
  fi

  mkdir -p "$CONFIG_DIR"
  echo "$alias=$dir" >> "$PROJECTS_FILE"
  PROJECTS[$alias]="$dir"
  echo "Added: $alias -> $dir"
}

# Remove a project from config
_remove() {
  local alias="$1"
  if [[ -z "$alias" ]]; then
    echo "Usage: dev remove <alias>"
    return 1
  fi

  if [[ -z "${PROJECTS[$alias]}" ]]; then
    echo "Unknown project: $alias"
    return 1
  fi

  # Remove line from config (atomic: write to tmp, verify, then replace)
  local tmpfile=$(mktemp "$CONFIG_DIR/projects.XXXXXX")
  grep -vE "^${alias}=" "$PROJECTS_FILE" > "$tmpfile" || true
  mv "$tmpfile" "$PROJECTS_FILE"
  unset "PROJECTS[$alias]"
  echo "Removed: $alias"
}

_find_repo_root() {
  # Method 1: ~/.local/bin/dev is a symlink to repo
  local dev_link="${HOME}/.local/bin/dev"
  if [[ -L "$dev_link" ]]; then
    local real_path
    real_path=$(readlink "$dev_link" 2>/dev/null)
    [[ -n "$real_path" ]] && { dirname "$real_path"; return; }
  fi
  # Method 2: stored config from install.sh
  local stored_conf="${CONFIG_DIR}/orchestra.conf"
  if [[ -f "$stored_conf" ]]; then
    local stored_repo
    stored_repo=$(grep "^ORCHESTRA_REPO=" "$stored_conf" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | sed "s|^~|$HOME|")
    if [[ -n "$stored_repo" && -d "${stored_repo}/.git" ]]; then
      echo "$stored_repo"; return
    fi
  fi
  # Method 3: common locations
  for candidate in \
    "${HOME}/claude-orchestra" \
    "${HOME}/Development/orchestra" \
    "${HOME}/.config/orchestra-repo" \
    "${HOME}/projects/claude-orchestra"; do
    if [[ -d "${candidate}/.git" && -f "${candidate}/dev" ]]; then
      echo "$candidate"; return
    fi
  done
  echo ""
}

_update() {
  echo ""
  echo "Orchestra Update"
  echo "================"
  echo ""

  if ! command -v curl &>/dev/null; then
    echo "ERROR: curl is required for dev update."
    return 1
  fi

  # Check latest release from GitHub API
  echo "Checking GitHub releases..."
  local api_resp latest_version
  api_resp=$(curl -sf "https://api.github.com/repos/alperduzgun/claude-orchestra/releases/latest" 2>/dev/null)
  if [[ -z "$api_resp" ]]; then
    echo "ERROR: Could not reach GitHub. Check your connection."
    return 1
  fi
  latest_version=$(echo "$api_resp" | grep '"tag_name"' | head -1 | cut -d'"' -f4)
  if [[ -z "$latest_version" ]]; then
    echo "ERROR: Could not parse latest release."
    return 1
  fi

  if [[ "$ORCHESTRA_VERSION" == "$latest_version" ]]; then
    echo "Already up to date ($ORCHESTRA_VERSION)."
    echo ""
    return 0
  fi

  echo "Current:  $ORCHESTRA_VERSION"
  echo "Latest:   $latest_version"
  echo ""

  # Show changelog — try local repo first, fall back to GitHub release notes
  local REPO_ROOT
  REPO_ROOT=$(_find_repo_root)
  if [[ -n "$REPO_ROOT" ]] && command -v git &>/dev/null; then
    git -C "$REPO_ROOT" fetch --tags origin 2>/dev/null
    local log
    log=$(git -C "$REPO_ROOT" log --oneline "HEAD..origin/main" 2>/dev/null | head -10)
    if [[ -n "$log" ]]; then
      echo "What's new:"
      echo "$log" | sed 's/^/  /'
      echo ""
    fi
  else
    local notes
    notes=$(echo "$api_resp" | grep '"body"' | head -1 | cut -d'"' -f4 | sed 's/\\r\\n/\n/g; s/\\n/\n/g' | head -8)
    if [[ -n "$notes" ]]; then
      echo "What's new:"
      echo "$notes" | sed 's/^/  /'
      echo ""
    fi
  fi

  local dev_mode="copy"
  [[ -L "${HOME}/.local/bin/dev" ]] && dev_mode="symlink"

  echo "Will update:"
  echo "  dev                    ~/.local/bin/dev"
  echo "  worker prompts         ${CONFIG_DIR}/AGENTS.md, WORKER.md, CLAUDE.md, CODEX.md, KIMI.md"
  echo "  shared docs            ${CONFIG_DIR}/ORCHESTRATOR.md, MODEL-SELECTION.md, TROUBLESHOOTING.md"
  echo "  orchestrator prompts   ${ORCH_DIR}/"
  echo ""
  echo "Preserved:"
  echo "  ${CONFIG_DIR}/projects.conf"
  [[ -f "${HOME}/.config/ghostty/config" ]] && echo "  ~/.config/ghostty/config"
  [[ -f "${HOME}/.tmux.conf" ]] && echo "  ~/.tmux.conf"
  echo ""

  read -k 1 "REPLY?Proceed? (y/N) "; echo ""
  [[ ! "$REPLY" =~ ^[Yy]$ ]] && { echo "Cancelled."; return 0; }

  echo ""
  echo "Updating..."

  local raw_base="https://raw.githubusercontent.com/alperduzgun/claude-orchestra/${latest_version}"
  local ok=true

  # Update dev script
  if [[ "$dev_mode" == "symlink" ]] && [[ -n "$REPO_ROOT" ]] && command -v git &>/dev/null; then
    if git -C "$REPO_ROOT" pull origin main 2>&1 | tail -3; then
      echo "  [ok]  dev → $latest_version  (git pull)"
    else
      echo "  [WARN] git pull failed — downloading directly..."
      curl -sf "${raw_base}/dev" -o "${HOME}/.local/bin/dev" && chmod +x "${HOME}/.local/bin/dev" \
        && echo "  [ok]  dev → $latest_version  (direct download)" \
        || { echo "  [FAIL] Could not update dev script."; ok=false; }
    fi
  else
    curl -sf "${raw_base}/dev" -o "${HOME}/.local/bin/dev" && chmod +x "${HOME}/.local/bin/dev" \
      && echo "  [ok]  dev → $latest_version" \
      || { echo "  [FAIL] Could not download dev script."; ok=false; }
    # Also pull local repo if present, best-effort
    [[ -n "$REPO_ROOT" ]] && command -v git &>/dev/null \
      && git -C "$REPO_ROOT" pull origin main &>/dev/null || true
  fi

  [[ "$ok" == "false" ]] && return 1

  # Re-link orchestra-status helper (worker idle/busy indicators)
  if [[ "$dev_mode" == "symlink" ]] && [[ -n "$REPO_ROOT" ]] && [[ -f "${REPO_ROOT}/orchestra-status.sh" ]]; then
    chmod +x "${REPO_ROOT}/orchestra-status.sh"
    if [[ ! -L "${HOME}/.local/bin/orchestra-status" ]] || \
       [[ "$(readlink "${HOME}/.local/bin/orchestra-status")" != "${REPO_ROOT}/orchestra-status.sh" ]]; then
      rm -f "${HOME}/.local/bin/orchestra-status"
      ln -s "${REPO_ROOT}/orchestra-status.sh" "${HOME}/.local/bin/orchestra-status" \
        && echo "  [ok]  orchestra-status → ${HOME}/.local/bin/orchestra-status"
    fi
  fi

  mkdir -p "${CONFIG_DIR}" "${ORCH_DIR}"

  local prompt_source_root=""
  if [[ -n "$REPO_ROOT" ]]; then
    prompt_source_root="$REPO_ROOT"
  fi

  for f in AGENTS.md WORKER.md CLAUDE.md KIMI.md CODEX.md FORGE.md ORCHESTRATOR.md MODEL-SELECTION.md TROUBLESHOOTING.md; do
    if [[ -n "$prompt_source_root" && -f "${prompt_source_root}/${f}" ]]; then
      cp "${prompt_source_root}/${f}" "${CONFIG_DIR}/${f}" && echo "  [ok]  ${f} → ${CONFIG_DIR}/${f}"
    elif curl -sf "${raw_base}/${f}" -o "${CONFIG_DIR}/${f}" 2>/dev/null; then
      echo "  [ok]  ${f} → ${CONFIG_DIR}/${f}"
    fi
  done

  for f in AGENTS.md CLAUDE.md KIMI.md CODEX.md FORGE.md ORCHESTRATOR.md MODEL-SELECTION.md TROUBLESHOOTING.md; do
    if [[ -n "$prompt_source_root" && -f "${prompt_source_root}/orchestrator/${f}" ]]; then
      cp "${prompt_source_root}/orchestrator/${f}" "${ORCH_DIR}/${f}" && echo "  [ok]  orchestrator/${f} → ${ORCH_DIR}/${f}"
    elif curl -sf "${raw_base}/orchestrator/${f}" -o "${ORCH_DIR}/${f}" 2>/dev/null; then
      echo "  [ok]  orchestrator/${f} → ${ORCH_DIR}/${f}"
    fi
  done

  echo ""
  echo "Updated to $latest_version."
  echo ""

  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local orch_cmd
    orch_cmd=$(tmux list-panes -t "${ORCH_SESSION}:orchestra" -F "#{pane_current_command}" 2>/dev/null | head -1)
    if [[ "$orch_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
      echo "Orchestrator is running with the OLD CLAUDE.md."
      echo "Restart: Ctrl+C in Ctrl+A 0, then run: dev"
      echo ""
    fi
    local workers
    workers=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null | grep -v "^orchestra$" | tr '\n' ' ')
    [[ -n "$workers" ]] && echo "Active workers continue unaffected: ${workers}"
  fi
}

# Helper: count active Claude windows in the orchestra session
_claude_count() {
  local count=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && count=$((count + 1))
    done <<< "$windows"
  fi
  echo "$count"
}

# Helper: count active Kimi windows in the orchestra session
_kimi_count() {
  local count=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      # Check if it's a Python process running kimi or the kimi command itself
      if [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
        count=$((count + 1))
      fi
    done <<< "$windows"
  fi
  echo "$count"
}

