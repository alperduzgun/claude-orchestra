#!/usr/bin/env zsh
# Dev - Project launcher & Claude Code / Kimi CLI orchestrator
# Usage: dev <project> | dev list | dev start <project> | dev send <project> "msg"
# Requires: zsh, tmux, Claude Code (https://docs.anthropic.com/en/docs/claude-code) or Kimi CLI (https://github.com/moonshot-ai/kimi-cli)

# Clear nested Claude Code detection
unset CLAUDECODE

# Dependency check
if ! command -v tmux &>/dev/null; then
  echo "ERROR: tmux is required but not found. Install it first."
  exit 1
fi

# Config
CONFIG_DIR="${ORCHESTRA_CONFIG_DIR:-$HOME/.config/orchestra}"
PROJECTS_FILE="$CONFIG_DIR/projects.conf"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
KIMI_BIN="${KIMI_BIN:-$(command -v kimi 2>/dev/null || echo "$HOME/.local/bin/kimi")}"

# AI window tracking file (stores which AI is running in each window)
AI_TRACK_FILE="$CONFIG_DIR/.ai_windows"

# Validate CLAUDE_BIN before any tmux send-keys usage (prevents injection)
_require_claude() {
  if [[ ! -x "$CLAUDE_BIN" ]]; then
    echo "ERROR: Claude binary not found or not executable: $CLAUDE_BIN"
    echo "Install Claude Code: https://docs.anthropic.com/en/docs/claude-code"
    return 1
  fi
}

# Validate KIMI_BIN
_require_kimi() {
  if [[ ! -x "$KIMI_BIN" ]]; then
    echo "ERROR: Kimi binary not found or not executable: $KIMI_BIN"
    echo "Install Kimi CLI: https://github.com/moonshot-ai/kimi-cli"
    return 1
  fi
}
ORCH_SESSION="${ORCHESTRA_SESSION:-devenv}"
# ORCH_DIR: where CLAUDE.md lives for orchestrator mode
# Override with ORCHESTRA_DIR env var or set in ~/.config/orchestra/orchestra.conf
ORCH_DIR="${ORCHESTRA_DIR:-$HOME/.config/orchestra}"
MAX_CLAUDE_SESSIONS="${MAX_CLAUDE_SESSIONS:-10}"
MAX_KIMI_SESSIONS="${MAX_KIMI_SESSIONS:-10}"
MAX_AI_SESSIONS="${MAX_AI_SESSIONS:-10}"
# Claude Code sets its process title to its version (e.g., "2.1.72"), not "node"
CLAUDE_PROC_PATTERN="^[0-9]+\.[0-9]+\.[0-9]+$"
# Kimi CLI process detection (Python process with kimi module)
KIMI_PROC_PATTERN="(kimi|python.*kimi)"
LOG_DIR="${HOME}/.local/share/orchestra/logs"
HISTORY_FILE="${HOME}/.local/share/orchestra/history.log"

# Log an action to history file
_log_history() {
  mkdir -p "$(dirname "$HISTORY_FILE")"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$HISTORY_FILE"
}

# Desktop notification helper (macOS + Linux)
_notify() {
  local title="${1:-Orchestra}"
  local msg="${2:-Task complete}"
  if command -v osascript &>/dev/null; then
    osascript - "$title" "$msg" <<'APPLESCRIPT' 2>/dev/null
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
  elif command -v notify-send &>/dev/null; then
    notify-send "$title" "$msg" 2>/dev/null
  fi
}

# Load projects from config file
typeset -A PROJECTS
_load_projects() {
  if [[ ! -f "$PROJECTS_FILE" ]]; then
    echo "No projects configured. Run: dev add <alias> /path/to/project"
    echo "Config: $PROJECTS_FILE"
    return 1
  fi
  while IFS='=' read -r key val; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    key="${key## }"; key="${key%% }"
    val="${val## }"; val="${val%% }"
    # Expand ~ and $HOME
    val="${val/#\~/$HOME}"
    val="${val/\$HOME/$HOME}"
    PROJECTS[$key]="$val"
  done < "$PROJECTS_FILE"
}

_load_projects

# Add a project to config
_add() {
  local alias="$1"
  local dir="$2"

  if [[ -z "$alias" || -z "$dir" ]]; then
    echo "Usage: dev add <alias> /path/to/project"
    return 1
  fi

  # Validate alias: only alphanumeric, hyphens, underscores
  if [[ ! "$alias" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Invalid alias: use only letters, numbers, hyphens, underscores"
    return 1
  fi

  # Resolve to absolute path
  dir="${dir/#\~/$HOME}"
  [[ ! "$dir" = /* ]] && dir="$(cd "$dir" 2>/dev/null && pwd)"

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  if [[ -n "${PROJECTS[$alias]}" ]]; then
    echo "Alias '$alias' already exists: ${PROJECTS[$alias]}"
    echo "Remove first with: dev remove $alias"
    return 1
  fi

  mkdir -p "$CONFIG_DIR"
  echo "$alias=$dir" >> "$PROJECTS_FILE"
  PROJECTS[$alias]="$dir"
  echo "Added: $alias -> $dir"
}

# Remove a project from config
_remove() {
  local alias="$1"
  if [[ -z "$alias" ]]; then
    echo "Usage: dev remove <alias>"
    return 1
  fi

  if [[ -z "${PROJECTS[$alias]}" ]]; then
    echo "Unknown project: $alias"
    return 1
  fi

  # Remove line from config (atomic: write to tmp, verify, then replace)
  local tmpfile=$(mktemp "$CONFIG_DIR/projects.XXXXXX")
  grep -vE "^${alias}=" "$PROJECTS_FILE" > "$tmpfile" || true
  mv "$tmpfile" "$PROJECTS_FILE"
  unset "PROJECTS[$alias]"
  echo "Removed: $alias"
}

_find_repo_root() {
  # Method 1: ~/.local/bin/dev is a symlink to repo
  local dev_link="${HOME}/.local/bin/dev"
  if [[ -L "$dev_link" ]]; then
    local real_path
    real_path=$(readlink "$dev_link" 2>/dev/null)
    [[ -n "$real_path" ]] && { dirname "$real_path"; return; }
  fi
  # Method 2: stored config from install.sh
  local stored_conf="${CONFIG_DIR}/orchestra.conf"
  if [[ -f "$stored_conf" ]]; then
    local stored_repo
    stored_repo=$(grep "^ORCHESTRA_REPO=" "$stored_conf" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | sed "s|^~|$HOME|")
    if [[ -n "$stored_repo" && -d "${stored_repo}/.git" ]]; then
      echo "$stored_repo"; return
    fi
  fi
  # Method 3: common locations
  for candidate in \
    "${HOME}/claude-orchestra" \
    "${HOME}/Development/orchestra" \
    "${HOME}/.config/orchestra-repo" \
    "${HOME}/projects/claude-orchestra"; do
    if [[ -d "${candidate}/.git" && -f "${candidate}/dev" ]]; then
      echo "$candidate"; return
    fi
  done
  echo ""
}

_update() {
  local REPO_ROOT
  REPO_ROOT=$(_find_repo_root)

  if [[ -z "$REPO_ROOT" ]]; then
    echo ""
    echo "Cannot find orchestra repository."
    echo "~/.local/bin/dev appears to be a copy, not a symlink — repo path unknown."
    echo ""
    echo "Fix (pick one):"
    echo "  echo 'ORCHESTRA_REPO=\"~/claude-orchestra\"' >> ${CONFIG_DIR}/orchestra.conf"
    echo "  (replace ~/claude-orchestra with your actual clone path)"
    echo ""
    echo "Or update manually:"
    echo "  cd ~/claude-orchestra && git pull"
    echo "  cp dev ~/.local/bin/dev && chmod +x ~/.local/bin/dev"
    echo "  cp CLAUDE.md KIMI.md MODEL-SELECTION.md ${CONFIG_DIR}/"
    return 1
  fi

  echo ""
  echo "Orchestra Update"
  echo "================"
  echo ""

  if ! command -v git &>/dev/null; then
    echo "ERROR: git not found."
    return 1
  fi

  echo "Fetching from origin..."
  if ! git -C "$REPO_ROOT" fetch --tags origin 2>&1 | grep -v "^$"; then
    echo "ERROR: Could not reach remote. Check your connection."
    return 1
  fi

  local current_tag latest_tag ahead_count
  current_tag=$(git -C "$REPO_ROOT" describe --tags --abbrev=0 HEAD 2>/dev/null || echo "")
  latest_tag=$(git -C "$REPO_ROOT" describe --tags --abbrev=0 origin/main 2>/dev/null || echo "")
  ahead_count=$(git -C "$REPO_ROOT" rev-list --count HEAD..origin/main 2>/dev/null || echo "0")

  if [[ "$ahead_count" == "0" ]]; then
    echo "Already up to date${current_tag:+ ($current_tag)}."
    echo ""
    return 0
  fi

  local current_label="${current_tag:-$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null)}"
  local latest_label="${latest_tag:-$(git -C "$REPO_ROOT" rev-parse --short origin/main 2>/dev/null)}"
  echo "Current:  ${current_label}"
  echo "Latest:   ${latest_label}  [${ahead_count} new commits]"
  echo ""
  echo "What's new:"
  git -C "$REPO_ROOT" log --oneline HEAD..origin/main | head -10 | sed 's/^/  /'
  echo ""

  local dev_mode="copy"
  [[ -L "${HOME}/.local/bin/dev" ]] && dev_mode="symlink"

  echo "Will update:"
  [[ "$dev_mode" == "copy" ]] && echo "  dev             ~/.local/bin/dev  [overwrite]"
  [[ "$dev_mode" == "symlink" ]] && echo "  dev             ~/.local/bin/dev  [symlink — auto via git pull]"
  for f in CLAUDE.md KIMI.md MODEL-SELECTION.md; do
    [[ -f "${REPO_ROOT}/${f}" ]] && echo "  ${f}  ${CONFIG_DIR}/${f}  [overwrite]"
  done
  echo ""
  echo "Preserved (never touched):"
  echo "  ${CONFIG_DIR}/projects.conf"
  [[ -f "${HOME}/.config/ghostty/config" ]] && echo "  ~/.config/ghostty/config"
  [[ -f "${HOME}/.tmux.conf" ]] && echo "  ~/.tmux.conf"
  echo ""

  read -p "Proceed? (y/N) " -n 1 -r; echo ""
  [[ ! "$REPLY" =~ ^[Yy]$ ]] && { echo "Cancelled."; return 0; }

  echo ""
  echo "Updating..."

  if ! git -C "$REPO_ROOT" pull origin main 2>&1 | tail -3; then
    echo "  [FAIL] git pull — resolve conflicts in ${REPO_ROOT} and retry"
    return 1
  fi
  echo "  [ok]  git pull${latest_label:+ → $latest_label} (${ahead_count} commits)"

  if [[ "$dev_mode" == "copy" ]]; then
    if cp "${REPO_ROOT}/dev" "${HOME}/.local/bin/dev" && chmod +x "${HOME}/.local/bin/dev"; then
      echo "  [ok]  dev -> ~/.local/bin/dev"
      # Save repo path for future updates
      local conf="${CONFIG_DIR}/orchestra.conf"
      { grep -v "^ORCHESTRA_REPO=" "$conf" 2>/dev/null || true; echo "ORCHESTRA_REPO=\"${REPO_ROOT}\""; } > "${conf}.tmp" && mv "${conf}.tmp" "$conf"
    else
      echo "  [WARN] dev copy failed — update manually: cp ${REPO_ROOT}/dev ~/.local/bin/dev"
    fi
  else
    echo "  [ok]  dev (symlink — already updated)"
  fi

  for f in CLAUDE.md KIMI.md MODEL-SELECTION.md; do
    if [[ -f "${REPO_ROOT}/${f}" ]]; then
      cp "${REPO_ROOT}/${f}" "${CONFIG_DIR}/${f}" && echo "  [ok]  ${f} -> ${CONFIG_DIR}/${f}"
    fi
  done

  echo ""
  echo "Update complete."
  echo ""

  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local orch_cmd
    orch_cmd=$(tmux list-panes -t "${ORCH_SESSION}:orchestra" -F "#{pane_current_command}" 2>/dev/null | head -1)
    if [[ "$orch_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
      echo "Orchestrator is running with the OLD CLAUDE.md."
      echo "Restart it to apply new prompts: Ctrl+C in Ctrl+A 0, then run: dev"
      echo ""
    fi
    local workers
    workers=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null | grep -v "^orchestra$" | tr '\n' ' ')
    [[ -n "$workers" ]] && echo "Active workers continue unaffected: ${workers}"
  else
    echo "Run 'dev' to start with the updated orchestrator."
  fi
}

# Helper: count active Claude windows in the orchestra session
_claude_count() {
  local count=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && count=$((count + 1))
    done <<< "$windows"
  fi
  echo "$count"
}

# Helper: count active Kimi windows in the orchestra session
_kimi_count() {
  local count=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      # Check if it's a Python process running kimi or the kimi command itself
      if [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
        count=$((count + 1))
      fi
    done <<< "$windows"
  fi
  echo "$count"
}

# AI type tracking per window
_track_ai_type() {
  local window="$1"
  local ai_type="$2"  # "claude" or "kimi"
  mkdir -p "$(dirname "$AI_TRACK_FILE")"
  # Remove existing entry for this window and add new one
  grep -v "^${window}:" "$AI_TRACK_FILE" 2>/dev/null > "$AI_TRACK_FILE.tmp" || true
  echo "$window:$ai_type" >> "$AI_TRACK_FILE.tmp"
  mv "$AI_TRACK_FILE.tmp" "$AI_TRACK_FILE"
}

# Track orchestrator AI type
_set_orchestrator_ai() {
  local ai_type="$1"
  echo -n "$ai_type" > "$CONFIG_DIR/.orchestrator_ai"
}

_get_orchestrator_ai() {
  if [[ -f "$CONFIG_DIR/.orchestrator_ai" ]]; then
    cat "$CONFIG_DIR/.orchestrator_ai" | tr -d '\n'
  else
    echo -n "claude"  # default (no newline)
  fi
}

_get_ai_type() {
  local window="$1"
  if [[ -f "$AI_TRACK_FILE" ]]; then
    grep "^${window}:" "$AI_TRACK_FILE" 2>/dev/null | cut -d: -f2
  fi
}

_detect_ai_type() {
  local name="$1"
  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
  
  if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    echo "claude"
  elif [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
    echo "kimi"
  else
    echo ""
  fi
}

_is_ai_running() {
  local name="$1"
  if ! _has_window "$name"; then return 1; fi
  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
  if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then return 0; fi
  if [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then return 0; fi
  return 1
}

_get_ai_bin() {
  local ai_type="$1"
  case "$ai_type" in
    claude) echo "$CLAUDE_BIN" ;;
    kimi) echo "$KIMI_BIN" ;;
    *) echo "" ;;
  esac
}

# Return the shell command that launches a given AI tool.
# Supported: claude, codex, kimi, qwen, gemini
_ai_launch_cmd() {
  local ai="$1"
  case "$ai" in
    claude) echo "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN 2>/dev/null; '$CLAUDE_BIN' --dangerously-skip-permissions" ;;
    kimi)   echo "'$KIMI_BIN'" ;;
    codex)  echo "codex exec" ;;
    qwen)   echo "qwen" ;;
    gemini) echo "gemini" ;;
    *)      return 1 ;;
  esac
}

# Validate that the AI's binary / command is available.
_ai_require() {
  local ai="$1"
  case "$ai" in
    claude) _require_claude ;;
    kimi)   _require_kimi ;;
    codex)  command -v codex  >/dev/null || { echo "ERROR: codex not found in PATH"; return 1; } ;;
    qwen)   command -v qwen   >/dev/null || { echo "ERROR: qwen not found in PATH"; return 1; } ;;
    gemini) command -v gemini >/dev/null || { echo "ERROR: gemini not found in PATH"; return 1; } ;;
    *)      echo "ERROR: unknown AI type: $ai (supported: claude, codex, kimi, qwen, gemini)"; return 1 ;;
  esac
}

# Detect which AI is running in a specific pane (by index).
_detect_pane_ai() {
  local name="$1"
  local pane_idx="$2"
  local pcmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_index} #{pane_current_command}" 2>/dev/null \
    | awk -v i="$pane_idx" '$1==i {print $2}')
  if [[ "$pcmd" =~ $CLAUDE_PROC_PATTERN ]]; then echo "claude"
  elif [[ "$pcmd" == "kimi" ]] || [[ "$pcmd" =~ ^[Pp]ython ]]; then echo "kimi"
  elif [[ "$pcmd" == "codex" ]]; then echo "codex"
  elif [[ "$pcmd" == "qwen" ]]; then echo "qwen"
  elif [[ "$pcmd" == "gemini" ]]; then echo "gemini"
  else echo "$pcmd"
  fi
}

# Helper: check if a worker AI is idle (done with task)
# Returns 0 if idle, 1 if working, 2 if not AI
_is_done() {
  local name="$1"
  local ai_type="${2:-$(_detect_ai_type "$name")}"
  if ! _has_window "$name"; then return 2; fi

  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
  
  # Check if it's an AI process
  local is_ai=false
  [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && is_ai=true
  [[ "$pane_cmd" =~ ^[Pp]ython ]] && is_ai=true
  [[ "$pane_cmd" == "kimi" ]] && is_ai=true
  [[ "$is_ai" == false ]] && return 2

  # Capture last 10 lines and check for active work indicators
  local output=$(tmux capture-pane -t "$ORCH_SESSION:$name" -p -S -10 2>/dev/null | \
    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tr -d '\xc2\xa0' | sed 's/[[:cntrl:]]//g')

  # Claude active patterns
  if echo "$output" | grep -qiE '(running\)|lculating|rnsfiguring|hinking|Reding.*files|iting.*files)'; then
    return 1
  fi
  
  # Kimi active patterns (working indicators)
  # Loading spinners (Unicode braille patterns)
  if echo "$output" | grep -qE '(⠙|⠹|⠸|⠼|⠴|⠦|⠧|⠇|⠏|⠋|⠛|⠞|⠿|⠻)'; then
    return 1
  fi
  # Tool use indicators
  if echo "$output" | grep -qE '(Using Shell|Using Read|Using Edit|Using Bash|Using Write|Thinking|Analyzing)'; then
    return 1
  fi

  # Idle patterns
  # Claude: ❯ at line start
  if echo "$output" | grep -qE '^\s*❯'; then
    return 0
  fi
  
  # Kimi idle: 💫 emoji (prompt indicator) + no active spinners above
  if echo "$output" | grep -qE '(💫|⭐|✨)'; then
    # Check if there's any active tool use after the prompt
    local after_prompt=$(echo "$output" | grep -A5 '💫' | tail -n +2)
    if ! echo "$after_prompt" | grep -qE '(⠙|⠹|⠸|Using)'; then
      return 0
    fi
  fi

  # Unknown — assume still working
  return 1
}

_done() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: dev done <project>"
    return 1
  fi
  local ai_type=$(_detect_ai_type "$name")
  _is_done "$name" "$ai_type"
  local result=$?
  case $result in
    0) echo "$name: idle (done)" ;;
    1) echo "$name: working..." ;;
    2) 
      if [[ -n "$ai_type" ]]; then
        echo "$name: not running AI ($ai_type detected but not responding)"
      else
        echo "$name: not running AI"
      fi
      ;;
  esac
  return $result
}

# Helper: check if a window exists in the orchestra session
_has_window() {
  tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null | grep -qx "$1"
}

# Helper: ensure the orchestra tmux session exists
_ensure_session() {
  if ! tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    if [[ ! -d "$ORCH_DIR" ]]; then
      mkdir -p "$ORCH_DIR" || { echo "ERROR: Cannot create ORCH_DIR: $ORCH_DIR"; return 1; }
    fi
    tmux new-session -d -s "$ORCH_SESSION" -n "orchestra" -c "$ORCH_DIR" || {
      echo "ERROR: Failed to create tmux session '$ORCH_SESSION'"
      return 1
    }
    sleep 0.5  # Give tmux time to initialize
  fi
  
  # Ensure orchestra window exists (create if missing)
  if ! tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null | grep -qx "orchestra"; then
    tmux new-window -t "$ORCH_SESSION" -n "orchestra" -c "$ORCH_DIR"
    sleep 0.3
  fi
}

_list() {
  if [[ ${#PROJECTS} -eq 0 ]]; then
    echo "No projects configured."
    echo "Add one with: dev add <alias> /path/to/project"
    return
  fi
  echo "Available projects:"
  echo ""
  printf "  %-18s %-40s %s\n" "ALIAS" "PATH" "STATUS"
  printf "  %-18s %-40s %s\n" "─────" "────" "──────"
  for key in ${(ok)PROJECTS}; do
    local dir="${PROJECTS[$key]}"
    local sess_state=""
    if _has_window "$key"; then
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$key" -F "#{pane_current_command}" 2>/dev/null | head -1)
      if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
        sess_state="[claude]"
      elif [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
        sess_state="[kimi]"
      else
        sess_state="[shell]"
      fi
    fi
    printf "  %-18s %-40s %s\n" "$key" "${dir/$HOME/~}" "$sess_state"
  done
  echo ""
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    echo "Windows in $ORCH_SESSION:"
    tmux list-windows -t "$ORCH_SESSION" -F "  #{window_index}: #{window_name} (#{pane_current_command})" 2>/dev/null
  else
    echo "Orchestra session not running."
  fi
}

_kill() {
  local name="$1"
  if _has_window "$name"; then
    tmux kill-window -t "$ORCH_SESSION:$name"
    echo "Killed window: $name"
  else
    echo "No window: $name"
  fi
}

_open() {
  local name="$1"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    echo "Run 'dev list' to see available projects"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  _ensure_session

  if _has_window "$name"; then
    if [[ -n "$TMUX" ]]; then
      tmux select-window -t "$ORCH_SESSION:$name"
    else
      tmux attach -t "$ORCH_SESSION:$name"
    fi
  else
    tmux new-window -t "$ORCH_SESSION" -n "$name" -c "$dir"
    if [[ -z "$TMUX" ]]; then
      tmux attach -t "$ORCH_SESSION:$name"
    fi
  fi
}

_claude() {
  local name="$1"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  cd "$dir" && claude
}

# Start AI worker based on orchestrator type
_start() {
  local name=""
  local dual=false
  local positional=()

  # Parse arguments — first non-flag arg is the project name; rest are AI specs for dual
  for arg in "$@"; do
    if [[ "$arg" == "--dual" ]]; then
      dual=true
    elif [[ "$arg" != "--"* ]]; then
      if [[ -z "$name" ]]; then
        name="$arg"
      else
        positional+=("$arg")
      fi
    fi
  done

  if [[ -z "$name" ]]; then
    echo "Usage: dev start <project> [--dual [left_ai] [right_ai]]"
    echo "  Supported AI types: claude, codex, kimi, qwen, gemini"
    echo "  Default dual: claude + codex"
    return 1
  fi

  if [[ "$dual" == "true" ]]; then
    _start_dual "$name" "${positional[@]}"
  else
    # Check orchestrator type and route accordingly
    local orch_ai=$(_get_orchestrator_ai)
    if [[ "$orch_ai" == "kimi" ]]; then
      _start_kimi "$name"
    else
      _start_claude "$name"
    fi
  fi
}

# Start Claude worker
_start_claude() {
  local name="$1"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  _require_claude || return 1
  _ensure_session || return 1

  # If window exists, check if Claude is running
  if _has_window "$name"; then
    local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
    if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
      echo "Already running: $name [claude]"
      return 0
    fi
    # Window exists but no Claude — attach logger then launch
    mkdir -p "$LOG_DIR"
    tmux pipe-pane -t "$ORCH_SESSION:$name" -o "cat >> '$LOG_DIR/${name}.log'"
    tmux send-keys -t "$ORCH_SESSION:$name" "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN 2>/dev/null; '$CLAUDE_BIN' --dangerously-skip-permissions" Enter
    echo "Launched Claude in existing window: $name"
  else
    # Enforce session limit
    local active=$(_claude_count)
    if [[ $active -ge $MAX_CLAUDE_SESSIONS ]]; then
      echo "ERROR: Max $MAX_CLAUDE_SESSIONS active Claude sessions reached (current: $active)."
      echo "Kill one first: dev kill <project>"
      return 1
    fi

    tmux new-window -t "$ORCH_SESSION" -n "$name" -c "$dir"
    # Attach logger before launching Claude (captures all output)
    mkdir -p "$LOG_DIR"
    tmux pipe-pane -t "$ORCH_SESSION:$name" -o "cat >> '$LOG_DIR/${name}.log'"
    sleep 0.5
    tmux send-keys -t "$ORCH_SESSION:$name" "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN 2>/dev/null; '$CLAUDE_BIN' --dangerously-skip-permissions" Enter
    echo "Started: $name -> ${dir/$HOME/~}"
  fi

  # Wait for Claude to be ready (poll for process, max 15s)
  local max_wait=15
  local waited=0
  while [[ $waited -lt $max_wait ]]; do
    local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
    [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && break
    sleep 1
    waited=$((waited + 1))
  done

  if [[ $waited -ge $max_wait ]]; then
    echo "WARNING: Claude may not be ready in $name (waited ${max_wait}s)"
  else
    local win_index=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":${name}$" | cut -d: -f1)
    _track_ai_type "$name" "claude"
    _log_history "START $name [window $win_index]"
    echo "Ready: $name [claude] [window $win_index] — switch with Ctrl+A $win_index"
  fi
}

# Start two AI tools side-by-side in split panes.
# Usage: _start_dual <project> [left_ai] [right_ai]   (defaults: claude, codex)
_start_dual() {
  local name="$1"
  local left_ai="${2:-claude}"
  local right_ai="${3:-codex}"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  # Resolve launch commands and verify binaries
  local left_cmd right_cmd
  left_cmd=$(_ai_launch_cmd "$left_ai")  || { echo "ERROR: unknown left AI '$left_ai' (supported: claude, codex, kimi, qwen, gemini)"; return 1; }
  right_cmd=$(_ai_launch_cmd "$right_ai") || { echo "ERROR: unknown right AI '$right_ai' (supported: claude, codex, kimi, qwen, gemini)"; return 1; }
  _ai_require "$left_ai"  || return 1
  _ai_require "$right_ai" || return 1
  _ensure_session || return 1

  # Enforce session limit (dual counts as 2)
  local total_active=$(( $(_claude_count) + $(_kimi_count) ))
  if [[ $total_active -ge $MAX_AI_SESSIONS ]]; then
    echo "ERROR: Max $MAX_AI_SESSIONS active AI sessions reached. Kill one first."
    return 1
  fi

  # Create window + launch LEFT AI
  tmux new-window -t "$ORCH_SESSION" -n "$name" -c "$dir"
  mkdir -p "$LOG_DIR"
  tmux pipe-pane -t "$ORCH_SESSION:$name" -o "cat >> '$LOG_DIR/${name}.log'"
  sleep 0.5
  tmux send-keys -t "$ORCH_SESSION:$name" "$left_cmd" Enter

  # Best-effort wait for left AI to appear (process detection is per-AI, keep it simple)
  sleep 2

  # Split right + launch RIGHT AI
  tmux split-window -h -t "$ORCH_SESSION:$name" -c "$dir"
  sleep 0.3
  tmux send-keys -t "$ORCH_SESSION:$name.2" "$right_cmd" Enter
  sleep 2

  # Select left pane as active
  tmux select-pane -t "$ORCH_SESSION:$name.1"

  local win_index=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":${name}$" | cut -d: -f1)
  _track_ai_type "$name" "dual:${left_ai}:${right_ai}"
  _log_history "START $name [dual:${left_ai}+${right_ai}] [window $win_index]"
  echo "Ready: $name [dual: ${left_ai}← ${right_ai}→] [window $win_index] — Ctrl+A $win_index"
  echo "  Send to ${left_ai}←:  dev send $name \"msg\""
  echo "  Send to ${right_ai}→: dev send $name --qwen \"msg\"   (or --right)"
}

# Start Kimi in a new window within the orchestra session
_start_kimi() {
  local name="$1"
  local dir="${PROJECTS[$name]}"

  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  _require_kimi || return 1
  _ensure_session || return 1

  # If window exists, check if Kimi is running
  if _has_window "$name"; then
    local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
    if [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
      echo "Already running: $name [kimi]"
      return 0
    fi
    # Window exists but no Kimi — attach logger then launch
    mkdir -p "$LOG_DIR"
    tmux pipe-pane -t "$ORCH_SESSION:$name" -o "cat >> '$LOG_DIR/${name}.log'"
    tmux send-keys -t "$ORCH_SESSION:$name" "cd '$dir' && '$KIMI_BIN'" Enter
    echo "Launched Kimi in existing window: $name"
  else
    # Enforce session limit (combined count)
    local claude_active=$(_claude_count)
    local kimi_active=$(_kimi_count)
    local total_active=$((claude_active + kimi_active))
    if [[ $total_active -ge $MAX_AI_SESSIONS ]]; then
      echo "ERROR: Max $MAX_AI_SESSIONS active AI sessions reached (Claude: $claude_active, Kimi: $kimi_active)."
      echo "Kill one first: dev kill <project>"
      return 1
    fi

    tmux new-window -t "$ORCH_SESSION" -n "$name" -c "$dir"
    # Attach logger before launching Kimi (captures all output)
    mkdir -p "$LOG_DIR"
    tmux pipe-pane -t "$ORCH_SESSION:$name" -o "cat >> '$LOG_DIR/${name}.log'"
    sleep 0.5
    tmux send-keys -t "$ORCH_SESSION:$name" "'$KIMI_BIN'" Enter
    echo "Started: $name [kimi] -> ${dir/$HOME/~}"
  fi

  # Wait for Kimi to be ready (poll for process, max 15s)
  local max_wait=15
  local waited=0
  while [[ $waited -lt $max_wait ]]; do
    local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$name" -F "#{pane_current_command}" 2>/dev/null | head -1)
    [[ "$pane_cmd" =~ ^[Pp]ython ]] && break
    [[ "$pane_cmd" == "kimi" ]] && break
    sleep 1
    waited=$((waited + 1))
  done

  if [[ $waited -ge $max_wait ]]; then
    echo "WARNING: Kimi may not be ready in $name (waited ${max_wait}s)"
  else
    local win_index=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":${name}$" | cut -d: -f1)
    _track_ai_type "$name" "kimi"
    _log_history "START-KIMI $name [window $win_index]"
    echo "Ready: $name [kimi] [window $win_index] — switch with Ctrl+A $win_index"
  fi
}

# Send a message to an AI window (Claude or Kimi)
_send() {
  local name=""
  local target="left"
  local msg_parts=()

  # Parse: dev send <project> [--qwen|--right|--left] <message>
  for arg in "$@"; do
    if [[ "$arg" == "--qwen" || "$arg" == "--right" ]]; then
      target="right"
    elif [[ "$arg" == "--left" ]]; then
      target="left"
    elif [[ -z "$name" ]]; then
      name="$arg"
    else
      msg_parts+=("$arg")
    fi
  done

  local msg="${msg_parts[*]}"

  # Validate project alias
  if [[ -z "${PROJECTS[$name]}" ]]; then
    echo "Unknown project: $name — run 'dev list'"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name — start with: dev start $name"
    return 1
  fi

  if [[ -z "$msg" ]]; then
    echo "Usage: dev send <project> [--qwen] <message>"
    return 1
  fi

  # Determine target pane
  local pane_target="$ORCH_SESSION:$name.1"
  if [[ "$target" == "right" ]]; then
    pane_target="$ORCH_SESSION:$name.2"
  fi

  # Detect which AI is actually running in the target pane (for logging).
  # Pane indices: 1 = left, 2 = right (after split-window -h).
  local pane_idx=1
  [[ "$target" == "right" ]] && pane_idx=2
  local ai_label=$(_detect_pane_ai "$name" "$pane_idx")
  [[ -z "$ai_label" ]] && ai_label="unknown"
  local ai_type="$ai_label"

  # Flatten multi-line messages to single line
  # (Both AI TUIs collapse pasted multi-line text into "[Pasted text]" and won't send it)
  msg="${msg//$'\n'/ }"
  msg="${msg//$'\r'/ }"

  if [[ ${#msg} -gt 1000 ]]; then
    local tmpfile=$(mktemp)
    printf '%s' "$msg" > "$tmpfile"
    tmux load-buffer "$tmpfile" && \
      tmux paste-buffer -t "$pane_target" && \
      sleep 0.3 && \
      tmux send-keys -t "$pane_target" Enter || {
        echo "ERROR: Failed to send long message to $name"
        rm -f "$tmpfile"
        return 1
      }
    rm -f "$tmpfile"
  else
    tmux send-keys -l -t "$pane_target" "$msg"
    tmux send-keys -t "$pane_target" Enter
  fi

  _log_history "SEND $name [$ai_label]: ${msg:0:200}"
  local win_index=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}:#{window_name}" 2>/dev/null | grep ":${name}$" | cut -d: -f1)
  echo "Sent to $name [$ai_label] [window $win_index]: ${msg:0:80}$([ ${#msg} -gt 80 ] && echo '...')"
}

# Show status of all active windows in the orchestra session
_status() {
  local found=0
  echo ""
  printf "  %-4s %-18s %-12s %s\n" "WIN" "PROJECT" "STATUS" "PATH"
  printf "  %-4s %-18s %-12s %s\n" "───" "───────" "──────" "────"

  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_index}|#{window_name}|#{pane_current_command}" 2>/dev/null)
    while IFS='|' read -r idx wname pcmd; do
      found=1
      local dir="${PROJECTS[$wname]}"
      [[ -z "$dir" ]] && dir="(orchestrator)"
      local sess_state="shell"
      if [[ "$pcmd" =~ $CLAUDE_PROC_PATTERN ]]; then
        sess_state="claude"
      elif [[ "$pcmd" =~ ^python ]] || [[ "$pcmd" == "kimi" ]]; then
        sess_state="kimi"
      fi
      printf "  %-4s %-18s %-12s %s\n" "$idx" "$wname" "[$sess_state]" "${dir/$HOME/~}"
    done <<< "$windows"
  fi

  [[ $found -eq 0 ]] && echo "  No active sessions. Start with: dev orchestra"
  echo ""
  local claude_count=$(_claude_count)
  local kimi_count=$(_kimi_count)
  echo "  Claude sessions: $claude_count | Kimi sessions: $kimi_count | Max: $MAX_AI_SESSIONS"
  echo ""
}

# Broadcast message to all active AI windows (Claude and Kimi)
_broadcast() {
  local msg="$*"
  if [[ -z "$msg" ]]; then
    echo "Usage: dev broadcast <message>"
    return 1
  fi

  local claude_count=0
  local kimi_count=0
  local skipped=0
  if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
    local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}" 2>/dev/null)
    while IFS= read -r wname; do
      [[ "$wname" == "orchestra" ]] && continue
      local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$wname" -F "#{pane_current_command}" 2>/dev/null | head -1)
      local is_ai=false
      if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
        is_ai=true
        claude_count=$((claude_count + 1))
      elif [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
        is_ai=true
        kimi_count=$((kimi_count + 1))
      fi
      
      if [[ "$is_ai" == true ]]; then
        _send "$wname" "$msg"
        sleep 0.2
      else
        skipped=$((skipped + 1))
      fi
    done <<< "$windows"
  fi
  local total=$((claude_count + kimi_count))
  echo "Broadcast to $total AI sessions (Claude: $claude_count, Kimi: $kimi_count, skipped: $skipped)."
}

# Peek at a worker's recent output
_peek() {
  local name=""
  local target="left"
  local lines="50"

  for arg in "$@"; do
    if [[ "$arg" == "--qwen" || "$arg" == "--right" ]]; then
      target="right"
    elif [[ "$arg" == "--left" ]]; then
      target="left"
    elif [[ -z "$name" ]]; then
      name="$arg"
    elif [[ "$arg" =~ ^[0-9]+$ ]]; then
      lines="$arg"
    fi
  done

  if [[ -z "$name" ]]; then
    echo "Usage: dev peek <project> [--qwen|--right|--left] [lines]"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name"
    return 1
  fi

  local pane_target="$ORCH_SESSION:$name.1"
  [[ "$target" == "right" ]] && pane_target="$ORCH_SESSION:$name.2"

  _log_history "PEEK $name [$target]"

  # Capture pane content and strip ANSI/TUI garbage
  tmux capture-pane -t "$pane_target" -p -S "-$lines" | \
    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | \
    sed 's/\x1b\][^\x07]*\x07//g' | \
    tr -d '\xc2\xa0' | \
    sed 's/[[:cntrl:]]//g' | \
    grep -v '^[[:space:]]*$' | \
    tail -"$lines"
}

# Live tail of worker's log file
_watch() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: dev watch <project>"
    return 1
  fi

  local logfile="$LOG_DIR/${name}.log"
  if [[ ! -f "$logfile" ]]; then
    echo "No log file for $name — start the worker first: dev start $name"
    return 1
  fi

  echo "Watching $name (Ctrl+C to stop)..."
  tail -f "$logfile" | \
    sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | \
    sed 's/\x1b\][^\x07]*\x07//g' | \
    tr -d '\xc2\xa0' | \
    sed 's/[[:cntrl:]]//g'
}

# Show task history
_history() {
  local filter="$1"
  local lines="${2:-30}"

  if [[ ! -f "$HISTORY_FILE" ]]; then
    echo "No history yet."
    return 0
  fi

  if [[ -n "$filter" ]]; then
    grep -iF "$filter" "$HISTORY_FILE" | tail -"$lines"
  else
    tail -"$lines" "$HISTORY_FILE"
  fi
}

# Wait for a worker to finish, then notify
_wait() {
  local name="$1"
  local max_wait="${2:-300}"  # default 5 minutes

  if [[ -z "$name" ]]; then
    echo "Usage: dev wait <project> [timeout_seconds]"
    return 1
  fi

  if ! _has_window "$name"; then
    echo "No window for $name"
    return 1
  fi

  echo "Waiting for $name to finish (max ${max_wait}s)..."
  local waited=0
  local start_time=$(date +%s)

  while [[ $waited -lt $max_wait ]]; do
    _is_done "$name"
    local result=$?
    if [[ $result -eq 0 ]]; then
      local elapsed=$(($(date +%s) - start_time))
      _log_history "DONE $name (${elapsed}s)"
      _notify "$name" "Task complete (${elapsed}s)"
      echo "$name: done (${elapsed}s)"
      return 0
    elif [[ $result -eq 2 ]]; then
      echo "$name: Claude not running"
      return 2
    fi
    sleep 3
    waited=$((waited + 3))
  done

  _notify "$name" "Timed out after ${max_wait}s"
  echo "$name: timed out after ${max_wait}s"
  return 1
}

# Send a question and wait for response
_ask() {
  local name="$1"
  shift
  local msg="$*"
  local timeout=120  # 2 min default

  if [[ -z "$name" || -z "$msg" ]]; then
    echo "Usage: dev ask <project> <question>"
    return 1
  fi

  # Send the message
  _send "$name" "$msg" || return 1

  # Wait for completion
  echo "Waiting for $name to respond..."
  local waited=0
  sleep 5  # give Claude a moment to start processing

  while [[ $waited -lt $timeout ]]; do
    _is_done "$name"
    local result=$?
    if [[ $result -eq 0 ]]; then
      _log_history "ASK-DONE $name (${waited}s)"
      echo ""
      echo "--- Response from $name ---"
      _peek "$name" 30
      _notify "$name" "Response ready"
      return 0
    elif [[ $result -eq 2 ]]; then
      echo "$name: Claude not running"
      return 2
    fi
    sleep 3
    waited=$((waited + 3))
  done

  echo "$name: timed out waiting for response (${timeout}s)"
  echo "--- Partial output ---"
  _peek "$name" 20
  return 1
}

# Run a non-interactive task using claude --print
_run() {
  local name="$1"
  shift
  local msg="$*"

  if [[ -z "$name" || -z "$msg" ]]; then
    echo "Usage: dev run <project> <task>"
    return 1
  fi

  local dir="${PROJECTS[$name]}"
  if [[ -z "$dir" ]]; then
    echo "Unknown project: $name"
    return 1
  fi

  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir"
    return 1
  fi

  local outfile="$LOG_DIR/${name}-run-$(date +%Y%m%d-%H%M%S).log"
  mkdir -p "$LOG_DIR"

  _log_history "RUN $name: ${msg:0:200}"
  echo "Running task in $name (non-interactive)..."
  echo "Output: $outfile"

  (
    unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
    cd "$dir" && "$CLAUDE_BIN" --print "$msg" > "$outfile" 2>&1
    local rc=$?
    if [[ $rc -eq 0 ]]; then
      _notify "$name" "Task finished"
      _log_history "RUN-DONE $name (exit 0)"
    else
      _notify "$name" "Task FAILED (exit $rc)"
      _log_history "RUN-FAILED $name (exit $rc)"
    fi
  ) &

  echo "Task running in background (PID: $!)"
  echo "Check output: cat $outfile"
}

# Recover crashed AI sessions
_recover() {
  local target="$1"

  if [[ "$target" == "--all" ]]; then
    # Recover all crashed sessions
    local claude_recovered=0
    local kimi_recovered=0
    if tmux has-session -t "$ORCH_SESSION" 2>/dev/null; then
      local windows=$(tmux list-windows -t "$ORCH_SESSION" -F "#{window_name}|#{pane_current_command}" 2>/dev/null)
      while IFS='|' read -r wname pcmd; do
        [[ "$wname" == "orchestra" ]] && continue
        [[ -z "${PROJECTS[$wname]}" ]] && continue
        
        # Check current AI type and recover accordingly
        if [[ ! "$pcmd" =~ $CLAUDE_PROC_PATTERN ]] && [[ ! "$pcmd" =~ ^python ]] && [[ "$pcmd" != "kimi" ]]; then
          # Window exists but no AI running - determine which AI was there
          local tracked_ai=$(_get_ai_type "$wname")
          local dir="${PROJECTS[$wname]}"
          
          if [[ "$tracked_ai" == "kimi" ]] || [[ -z "$tracked_ai" && -x "$KIMI_BIN" ]]; then
            echo "Recovering $wname [kimi]..."
            tmux send-keys -t "$ORCH_SESSION:$wname" "cd '$dir' && '$KIMI_BIN'" Enter
            kimi_recovered=$((kimi_recovered + 1))
            _log_history "RECOVER-KIMI $wname"
          else
            echo "Recovering $wname [claude]..."
            tmux send-keys -t "$ORCH_SESSION:$wname" "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN 2>/dev/null; '$CLAUDE_BIN' --dangerously-skip-permissions --resume" Enter
            claude_recovered=$((claude_recovered + 1))
            _log_history "RECOVER $wname"
          fi
        fi
      done <<< "$windows"
    fi
    echo "Recovered $((claude_recovered + kimi_recovered)) sessions (Claude: $claude_recovered, Kimi: $kimi_recovered)."
    return 0
  fi

  if [[ -z "$target" ]]; then
    echo "Usage: dev recover <project> | dev recover --all"
    return 1
  fi

  if [[ -z "${PROJECTS[$target]}" ]]; then
    echo "Unknown project: $target"
    return 1
  fi

  if ! _has_window "$target"; then
    echo "No window for $target — start with: dev start $target"
    return 1
  fi

  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
  local dir="${PROJECTS[$target]}"
  local tracked_ai=$(_get_ai_type "$target")
  
  # Check if already running
  if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    echo "$target: Claude is already running"
    return 0
  fi
  if [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
    echo "$target: Kimi is already running"
    return 0
  fi
  
  # Determine which AI to recover
  if [[ "$tracked_ai" == "kimi" ]]; then
    echo "Recovering $target [kimi]..."
    tmux send-keys -t "$ORCH_SESSION:$target" "cd '$dir' && '$KIMI_BIN'" Enter
    _log_history "RECOVER-KIMI $target"
    
    # Wait for readiness
    local max_wait=15
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
      pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ ^python ]] && break
      [[ "$pane_cmd" == "kimi" ]] && break
      sleep 1
      waited=$((waited + 1))
    done
    
    if [[ $waited -ge $max_wait ]]; then
      echo "WARNING: Kimi may not be ready in $target"
    else
      echo "Recovered: $target [kimi]"
      _notify "$target" "Kimi session recovered"
    fi
  else
    echo "Recovering $target [claude]..."
    tmux send-keys -t "$ORCH_SESSION:$target" "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN 2>/dev/null; '$CLAUDE_BIN' --dangerously-skip-permissions --resume" Enter
    _log_history "RECOVER $target"

    # Wait for readiness
    local max_wait=15
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
      pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:$target" -F "#{pane_current_command}" 2>/dev/null | head -1)
      [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]] && break
      sleep 1
      waited=$((waited + 1))
    done

    if [[ $waited -ge $max_wait ]]; then
      echo "WARNING: Claude may not be ready in $target"
    else
      echo "Recovered: $target [claude]"
      _notify "$target" "Session recovered"
    fi
  fi
}

# Start orchestrator: create master session, open Claude or Kimi in window 0
_orchestra() {
  _ensure_session || return 1

  # Check which orchestrator to use (default: Claude)
  local orch_ai="${ORCHESTRA_AI:-claude}"
  local orch_bin=""
  local orch_file=""
  
  if [[ "$orch_ai" == "kimi" ]]; then
    _require_kimi || return 1
    orch_bin="$KIMI_BIN"
    orch_file="$ORCH_DIR/KIMI.md"
    # Create KIMI.md if it doesn't exist
    if [[ ! -f "$orch_file" ]]; then
      cat > "$orch_file" << 'KIMIEOF'
# Orchestra - Kimi CLI Orchestrator

## Communication
- Be short and direct
- Report actions taken, not plans

## Role
You are the orchestrator Kimi. You manage multiple Kimi CLI worker sessions from this single terminal via tmux windows.

## Startup Sequence
1. Run `~/.local/bin/dev status` to check current state
2. Ask the user which projects they want to work on
3. Start sessions with: `dev kimi start <project>`

## Commands (always use full path via Bash tool)
```bash
~/.local/bin/dev kimi start <alias>       # Start a Kimi session
~/.local/bin/dev send <alias> "message"   # Send a task/message (auto-detects AI type)
~/.local/bin/dev peek <alias>             # Read worker's recent output
~/.local/bin/dev broadcast "message"      # Send to ALL active AI sessions
~/.local/bin/dev kill <alias>             # Kill a project window
~/.local/bin/dev list                     # List all projects
~/.local/bin/dev status                   # Show active windows
~/.local/bin/dev done <alias>             # Check if worker is idle
~/.local/bin/dev wait <alias>             # Wait for worker to finish
```

## Task Lifecycle
1. **Send task:** `dev send <alias> "detailed task description"`
2. **Wait:** `sleep 20`
3. **Check output:** `dev peek <alias>` to read the worker's response
4. **Still working?** If worker is still busy, `sleep 15` and `dev peek` again
5. **Report to user:** Summarize what the worker did or said

## Rules
- Max $MAX_AI_SESSIONS concurrent AI sessions (Claude + Kimi combined)
- Include full context in every message to workers
- Workers have zero knowledge of this conversation
- Always tell the user the window number after starting
KIMIEOF
    fi
  else
    _require_claude || return 1
    orch_bin="$CLAUDE_BIN"
    orch_file="$ORCH_DIR/CLAUDE.md"
  fi

  # Check what's currently running in orchestra window
  local pane_cmd=$(tmux list-panes -t "$ORCH_SESSION:orchestra" -F "#{pane_current_command}" 2>/dev/null | head -1)
  local current_ai=""
  
  # Detect current AI type
  if [[ "$pane_cmd" =~ $CLAUDE_PROC_PATTERN ]]; then
    current_ai="claude"
  elif [[ "$pane_cmd" =~ ^python ]] || [[ "$pane_cmd" == "kimi" ]]; then
    current_ai="kimi"
  fi
  
  # If a different AI is running, kill it first
  if [[ -n "$current_ai" && "$current_ai" != "$orch_ai" ]]; then
    echo "Switching orchestrator from $current_ai to $orch_ai..."
    tmux send-keys -t "$ORCH_SESSION:orchestra" C-c
    sleep 0.5
    tmux send-keys -t "$ORCH_SESSION:orchestra" C-d
    sleep 0.2
    current_ai=""
  fi
  
  # Save orchestrator AI type
  _set_orchestrator_ai "$orch_ai"
  
  # Launch AI if not already running
  if [[ "$current_ai" != "$orch_ai" ]]; then
    if [[ "$orch_ai" == "kimi" ]]; then
      tmux send-keys -t "$ORCH_SESSION:orchestra" "cd '$ORCH_DIR' && '$orch_bin'" Enter
      echo "Starting Kimi orchestrator..."
    else
      tmux send-keys -t "$ORCH_SESSION:orchestra" "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN 2>/dev/null; cd '$ORCH_DIR' && '$orch_bin' --dangerously-skip-permissions" Enter
      echo "Starting Claude orchestrator..."
    fi
    sleep 1
  else
    echo "$orch_ai orchestrator already running."
  fi

  # Now attach/switch (blocking — nothing runs after this until detach)
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$ORCH_SESSION:orchestra"
  else
    tmux attach -t "$ORCH_SESSION:orchestra"
  fi
}

case "$1" in
  list|ls)        _list ;;
  kill)           _kill "$2" ;;
  claude|cc)      _claude "$2" ;;
  start)          _start "${@:2}" ;;
  kimi)
    # Kimi subcommands
    case "$2" in
      start)      _start_kimi "$3" ;;
      send)       _send "$3" "${@:4}" ;;
      peek)       _peek "$3" "$4" ;;
      status)     _status ;;
      broadcast)  _broadcast "${@:3}" ;;
      watch)      _watch "$3" ;;
      wait)       _wait "$3" "$4" ;;
      ask)        _ask "$3" "${@:4}" ;;
      done)       _done "$3" ;;
      recover)    _recover "$3" ;;
      "")         ORCHESTRA_AI=kimi _orchestra ;;  # Start Kimi orchestrator
      *)
        echo "Kimi commands:"
        echo "  dev kimi                   Start Kimi orchestrator"
        echo "  dev kimi start <project>   Start Kimi in a window"
        echo "  dev kimi send <p> <msg>    Send message to project's Kimi"
        echo "  dev kimi peek <p> [lines]  Read Kimi's recent output"
        echo "  dev kimi status            Show Kimi windows status"
        echo "  dev kimi broadcast <msg>   Send to all Kimi sessions"
        echo "  dev kimi watch <project>   Live tail of Kimi's log"
        echo "  dev kimi wait <p> [sec]    Wait for Kimi to finish"
        echo "  dev kimi ask <p> <msg>     Send question to Kimi"
        echo "  dev kimi done <project>    Check if Kimi is idle"
        echo "  dev kimi recover <p>       Recover crashed Kimi session"
        ;;
    esac
    ;;
  send)           _send "${@:2}" ;;
  status)         _status ;;
  broadcast)      _broadcast "${@:2}" ;;
  orchestra|orch|o) _orchestra ;;
  peek)           _peek "${@:2}" ;;
  watch)          _watch "$2" ;;
  history)        _history "$2" "$3" ;;
  wait)           _wait "$2" "$3" ;;
  ask)            _ask "$2" "${@:3}" ;;
  run)            _run "$2" "${@:3}" ;;
  recover)        _recover "$2" ;;
  notify)         _notify "$2" "${@:3}" ;;
  done)           _done "$2" ;;
  add)            _add "$2" "$3" ;;
  remove|rm)      _remove "$2" ;;
  update|up)      _update ;;
  help|-h)
    echo "Usage:"
    echo "  dev                        Start Claude orchestrator (shortcut)"
    echo "  dev kimi                   Start Kimi orchestrator"
    echo "  dev orchestra              Start orchestrator (master session)"
    echo "  dev start <project>        Start Claude in a window (max $MAX_AI_SESSIONS total)"
    echo "  dev start <p> --dual [L] [R]  Dual pane, any AI combo (default: claude codex)"
    echo "                               L/R ∈ {claude, codex, kimi, qwen, gemini}"
    echo "  dev kimi start <project>   Start Kimi in a window"
    echo "  dev send <p> [--right|--qwen|--left] <msg>   Send message (right pane in dual)"
    echo "  dev peek <p> [--right|--qwen|--left] [lines] Read output (right pane in dual)"
    echo "  dev broadcast <msg>        Send to all active AI sessions"
    echo "  dev status                 Show all windows and their status"
    echo "  dev list                   List all projects"
    echo "  dev add <alias> <path>     Add a project"
    echo "  dev remove <alias>         Remove a project"
    echo "  dev watch <project>        Live tail of worker's log"
    echo "  dev history [alias] [n]    Show recent task history"
    echo "  dev wait <project> [sec]   Wait for worker to finish, then notify"
    echo "  dev ask <project> <msg>    Send question, wait for response, show it"
    echo "  dev run <project> <task>   Run non-interactive task (claude --print)"
    echo "  dev recover <project>      Recover crashed session"
    echo "  dev recover --all          Recover all crashed sessions"
    echo "  dev update                 Update orchestra to the latest version"
    echo "  dev done <project>         Check if worker is idle or working"
    echo "  dev notify <title> <msg>   Send a desktop notification (macOS + Linux)"
    echo "  dev kill <project>         Kill a project window"
    echo "  dev cc <project>           Open Claude Code directly in project"
    echo "  dev <project>              Open project shell in a window"
    echo "  dev help                   Show this help"
    echo ""
    echo "Environment variables:"
    echo "  CLAUDE_BIN                 Path to Claude binary (default: auto-detect)"
    echo "  KIMI_BIN                   Path to Kimi binary (default: auto-detect)"
    echo "  MAX_AI_SESSIONS            Max concurrent AI sessions (default: 3)"
    ;;
  "")             _orchestra ;;
  *)              _open "$1" ;;
esac
