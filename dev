        echo "  dev codex ask <p> <msg>    Send question to Codex"
        echo "  dev codex done <project>   Check if Codex is idle"
        echo "  dev codex recover <p>      Recover crashed Codex session"
        ;;
    esac
    ;;
  forge)
    # Forge subcommands
    case "$2" in
      start)      _start_forge "$3" ;;
      send)       _send "$3" "${@:4}" ;;
      peek)       _peek "$3" "$4" ;;
      status)     _status ;;
      broadcast)  _broadcast "${@:3}" ;;
      watch)      _watch "$3" ;;
      wait)       _wait "$3" "$4" ;;
      ask)        _ask "$3" "${@:4}" ;;
      done)       _done "$3" ;;
      recover)    _recover "$3" ;;
      "")         ORCHESTRA_AI=forge _orchestra ;;  # Start Forge orchestrator
      *)
        echo "Forge commands:"
        echo "  dev forge                  Start Forge orchestrator"
        echo "  dev forge start <project>  Start Forge in a window"
        echo "  dev forge send <p> <msg>   Send message to project's Forge"
        echo "  dev forge peek <p> [lines] Read Forge's recent output"
