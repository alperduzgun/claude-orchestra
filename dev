        echo "  dev forge done <project>   Check if Forge is idle"
        echo "  dev forge recover <p>      Recover crashed Forge session"
        ;;
    esac
    ;;
  send)           _send "${@:2}" ;;
  status)         _status ;;
  broadcast)      _broadcast "${@:2}" ;;
  orchestra|orch|o) _orchestra ;;
  peek)           _peek "${@:2}" ;;
  watch)          _watch "$2" ;;
  history)        _history "$2" "$3" ;;
  wait)           _wait "$2" "$3" ;;
  ask)            _ask "$2" "${@:3}" ;;
  run)            _run "$2" "${@:3}" ;;
  recover)        _recover "$2" ;;
  notify)         _notify "$2" "${@:3}" ;;
  done)           _done "$2" ;;
